  <Sequence DisplayName="Step3 재시도 테스트"><Sequence.Variables><Variable x:TypeArguments="x:String" Default="[System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;test_data&quot;)]" Name="testDir" /><Variable x:TypeArguments="x:String" Default="[System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;test_data_out&quot;)]" Name="outDir" /><Variable x:TypeArguments="x:Int32" Default="[2]" Name="maxRetry" /><Variable x:TypeArguments="scg:List(x:String)" Default="[New System.Collections.Generic.List(Of String) From {&quot;sc1_first_ok&quot;, &quot;sc2_second_ok&quot;, &quot;sc3_third_ok&quot;, &quot;sc4_all_fail_validation&quot;, &quot;sc5_all_fail_parse&quot;, &quot;sc6_fenced_first_ok&quot;, &quot;sc7_last_reason_wins&quot;}]" Name="scenarios" /></Sequence.Variables><ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="시나리오별 반복" Values="[scenarios]"><ui:ForEach.Body><ActivityAction x:TypeArguments="x:String"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="x:String" Name="scName" /></ActivityAction.Argument><Sequence DisplayName="시나리오 처리"><Sequence.Variables><Variable x:TypeArguments="x:String" Name="responseText" /><Variable x:TypeArguments="x:Boolean" Name="isValid" /><Variable x:TypeArguments="x:String" Name="errorText" /><Variable x:TypeArguments="x:String" Name="cleanedJson" /><Variable x:TypeArguments="x:String" Name="resultJson" /><Variable x:TypeArguments="x:Boolean" Default="[False]" Name="isDone" /><Variable x:TypeArguments="x:String" Default="[&quot;원인 불명&quot;]" Name="lastError" /><Variable x:TypeArguments="x:Int32" Default="[0]" Name="attemptUsed" /><Variable x:TypeArguments="x:String" Name="cleanedFinal" /><Variable x:TypeArguments="x:String" Name="finalJson" /></Sequence.Variables><ui:ForEach x:TypeArguments="x:Int32" CurrentIndex="{x:Null}" DisplayName="시도 반복 (최초 1회 + 재시도)" Values="[Enumerable.Range(0, maxRetry + 1)]"><ui:ForEach.Body><ActivityAction x:TypeArguments="x:Int32"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="x:Int32" Name="attempt" /></ActivityAction.Argument><If Condition="[Not isDone]" DisplayName="아직 성공 못 했으면 시도"><If.Then><Sequence DisplayName="시도"><ui:ReadTextFile File="{x:Null}" Content="[responseText]" DisplayName="시도별 응답 읽기 (모의: 실제 호출 대신 파일)" Encoding="utf-8" FileName="[System.IO.Path.Combine(testDir, &quot;step3&quot;, scName, &quot;attempt&quot; &amp; (attempt + 1).ToString() &amp; &quot;.txt&quot;)]" /><ui:InvokeCode DisplayName="응답 검증 (Invoke Code)" Language="VBNet" Code="' Step2: 응답 JSON 추출·검증  (Python: analyze.extract_json + analyze.validate + 필드 화이트리스트)&#xA;' In : responseText(String) 모델이 돌려준 원문&#xA;' Out: isValid(Boolean), errorText(String; 성공이면 &quot;&quot;), cleanedJson(String; 성공 시 정의된 필드만 남긴 JSON),&#xA;'      resultJson(String; {&quot;isValid&quot;,&quot;errorText&quot;,&quot;cleaned&quot;} — 테스트 비교용)&#xA;isValid = False&#xA;errorText = &quot;&quot;&#xA;cleanedJson = &quot;&quot;&#xA;resultJson = &quot;&quot;&#xA;Dim parseLabel As String = &quot;&quot;&#xA;Dim root As Newtonsoft.Json.Linq.JObject = Nothing&#xA;Dim cleaned As Newtonsoft.Json.Linq.JObject = Nothing&#xA;Dim errs As New System.Collections.Generic.List(Of String)&#xA;&#xA;' 1) 코드펜스 제거 후 첫 '{' ~ 마지막 '}' 구간을 JSON으로 파싱 (Python: extract_json)&#xA;Dim txt As String = System.Text.RegularExpressions.Regex.Replace(If(responseText, &quot;&quot;), &quot;```(?:json)?&quot;, &quot;&quot;).Trim()&#xA;Dim sIdx As Integer = txt.IndexOf(&quot;{&quot;, System.StringComparison.Ordinal)&#xA;Dim eIdx As Integer = txt.LastIndexOf(&quot;}&quot;, System.StringComparison.Ordinal)&#xA;If sIdx &lt; 0 OrElse eIdx &lt;= sIdx Then&#xA;    parseLabel = &quot;ValueError&quot;&#xA;Else&#xA;    Try&#xA;        Dim rd As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(txt.Substring(sIdx, eIdx - sIdx + 1)))&#xA;        rd.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;        root = Newtonsoft.Json.Linq.JObject.Load(rd)&#xA;        If rd.Read() Then parseLabel = &quot;JSONDecodeError&quot;&#xA;    Catch ex As System.Exception&#xA;        parseLabel = &quot;JSONDecodeError&quot;&#xA;    End Try&#xA;End If&#xA;&#xA;If parseLabel &lt;&gt; &quot;&quot; Then&#xA;    errorText = &quot;응답 파싱 실패(&quot; &amp; parseLabel &amp; &quot;)&quot;&#xA;Else&#xA;    Dim requiredKeys As String() = New String() {&quot;type&quot;, &quot;type_confidence&quot;, &quot;customer_company&quot;, &quot;customer_question&quot;, &quot;agent_action&quot;, &quot;summary&quot;, &quot;follow_up_required&quot;, &quot;follow_up&quot;, &quot;keywords&quot;, &quot;entities&quot;}&#xA;    Dim typeCodes As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;INQUIRY&quot;, &quot;COMPLAINT&quot;, &quot;SUGGESTION&quot;, &quot;TRAINING&quot;, &quot;OTHER&quot;})&#xA;    Dim entityTypes As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;PRODUCT&quot;, &quot;ORG&quot;, &quot;DATE&quot;, &quot;AMOUNT&quot;, &quot;REF_NO&quot;, &quot;OTHER&quot;})&#xA;&#xA;    ' Python 의 repr 처럼 값을 표시 (오류 메시지 호환용)&#xA;    Dim pyRepr As System.Func(Of Newtonsoft.Json.Linq.JToken, String) = Function(t As Newtonsoft.Json.Linq.JToken) As String&#xA;                                                                             Dim r As String&#xA;                                                                             Select Case t.Type&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Null&#xA;                                                                                     r = &quot;None&quot;&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.String&#xA;                                                                                     Dim sv As String = CStr(CType(t, Newtonsoft.Json.Linq.JValue).Value)&#xA;                                                                                     If sv.Contains(&quot;'&quot;) AndAlso Not sv.Contains(&quot;&quot;&quot;&quot;) Then&#xA;                                                                                         r = &quot;&quot;&quot;&quot; &amp; sv &amp; &quot;&quot;&quot;&quot;&#xA;                                                                                     Else&#xA;                                                                                         r = &quot;'&quot; &amp; sv.Replace(&quot;\&quot;, &quot;\\&quot;).Replace(&quot;'&quot;, &quot;\'&quot;).Replace(vbLf, &quot;\n&quot;).Replace(vbCr, &quot;\r&quot;).Replace(vbTab, &quot;\t&quot;) &amp; &quot;'&quot;&#xA;                                                                                     End If&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Boolean&#xA;                                                                                     r = If(CBool(CType(t, Newtonsoft.Json.Linq.JValue).Value), &quot;True&quot;, &quot;False&quot;)&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Integer&#xA;                                                                                     r = System.Convert.ToString(CType(t, Newtonsoft.Json.Linq.JValue).Value, System.Globalization.CultureInfo.InvariantCulture)&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Float&#xA;                                                                                     Dim dv As Double = CDbl(CType(t, Newtonsoft.Json.Linq.JValue).Value)&#xA;                                                                                     r = dv.ToString(&quot;R&quot;, System.Globalization.CultureInfo.InvariantCulture)&#xA;                                                                                     If dv = System.Math.Floor(dv) AndAlso Not r.Contains(&quot;E&quot;) Then r = r &amp; &quot;.0&quot;&#xA;                                                                                 Case Else&#xA;                                                                                     r = t.ToString(Newtonsoft.Json.Formatting.None)&#xA;                                                                             End Select&#xA;                                                                             Return r&#xA;                                                                         End Function&#xA;    ' Python 의 truthiness (not x.get(&quot;value&quot;) 판정용)&#xA;    Dim truthy As System.Func(Of Newtonsoft.Json.Linq.JToken, Boolean) = Function(t As Newtonsoft.Json.Linq.JToken) As Boolean&#xA;                                                                              Dim r As Boolean = False&#xA;                                                                              If t IsNot Nothing Then&#xA;                                                                                  Select Case t.Type&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Null&#xA;                                                                                          r = False&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.String&#xA;                                                                                          r = CStr(CType(t, Newtonsoft.Json.Linq.JValue).Value).Length &gt; 0&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Boolean&#xA;                                                                                          r = CBool(CType(t, Newtonsoft.Json.Linq.JValue).Value)&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Integer, Newtonsoft.Json.Linq.JTokenType.Float&#xA;                                                                                          r = CDbl(CType(t, Newtonsoft.Json.Linq.JValue).Value) &lt;&gt; 0&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Array, Newtonsoft.Json.Linq.JTokenType.Object&#xA;                                                                                          r = t.HasValues&#xA;                                                                                      Case Else&#xA;                                                                                          r = True&#xA;                                                                                  End Select&#xA;                                                                              End If&#xA;                                                                              Return r&#xA;                                                                          End Function&#xA;&#xA;    ' 2) 필수 키 (하나라도 없으면 거기서 끝, Python: errs 가 있으면 즉시 반환)&#xA;    For Each k As String In requiredKeys&#xA;        If root(k) Is Nothing Then errs.Add(k &amp; &quot; 누락&quot;)&#xA;    Next&#xA;&#xA;    ' 3) 값 검증 (Python: validate)&#xA;    If errs.Count = 0 Then&#xA;        Dim typeTok As Newtonsoft.Json.Linq.JToken = root(&quot;type&quot;)&#xA;        If Not (typeTok.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso typeCodes.Contains(CStr(CType(typeTok, Newtonsoft.Json.Linq.JValue).Value))) Then&#xA;            errs.Add(&quot;type enum 위반: &quot; &amp; pyRepr(typeTok))&#xA;        End If&#xA;&#xA;        Dim confTok As Newtonsoft.Json.Linq.JToken = root(&quot;type_confidence&quot;)&#xA;        Dim confOk As Boolean = False&#xA;        If confTok.Type = Newtonsoft.Json.Linq.JTokenType.Integer OrElse confTok.Type = Newtonsoft.Json.Linq.JTokenType.Float Then&#xA;            Dim cv As Double = CDbl(CType(confTok, Newtonsoft.Json.Linq.JValue).Value)&#xA;            confOk = (cv &gt;= 0.0 AndAlso cv &lt;= 1.0)&#xA;        End If&#xA;        If Not confOk Then errs.Add(&quot;type_confidence 범위 위반&quot;)&#xA;&#xA;        Dim sumTok As Newtonsoft.Json.Linq.JToken = root(&quot;summary&quot;)&#xA;        Dim sumOk As Boolean = False&#xA;        If sumTok.Type = Newtonsoft.Json.Linq.JTokenType.String Then&#xA;            Dim sl As Integer = CStr(CType(sumTok, Newtonsoft.Json.Linq.JValue).Value).Length&#xA;            sumOk = (sl &gt; 0 AndAlso sl &lt;= 300)&#xA;        End If&#xA;        If Not sumOk Then errs.Add(&quot;summary 비었거나 300자 초과&quot;)&#xA;&#xA;        For Each k As String In New String() {&quot;customer_question&quot;, &quot;agent_action&quot;}&#xA;            Dim tk As Newtonsoft.Json.Linq.JToken = root(k)&#xA;            If tk.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xA;                Dim okLen As Boolean = False&#xA;                If tk.Type = Newtonsoft.Json.Linq.JTokenType.String Then&#xA;                    Dim ln As Integer = CStr(CType(tk, Newtonsoft.Json.Linq.JValue).Value).Length&#xA;                    okLen = (ln &gt; 0 AndAlso ln &lt;= 200)&#xA;                End If&#xA;                If Not okLen Then errs.Add(k &amp; &quot; 길이/형식 위반&quot;)&#xA;            End If&#xA;        Next&#xA;&#xA;        If root(&quot;follow_up_required&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Boolean Then errs.Add(&quot;follow_up_required는 boolean&quot;)&#xA;&#xA;        Dim kwTok As Newtonsoft.Json.Linq.JToken = root(&quot;keywords&quot;)&#xA;        If Not (kwTok.Type = Newtonsoft.Json.Linq.JTokenType.Array AndAlso CType(kwTok, Newtonsoft.Json.Linq.JArray).Count &lt;= 5) Then errs.Add(&quot;keywords는 최대 5개 배열&quot;)&#xA;&#xA;        Dim entTok As Newtonsoft.Json.Linq.JToken = root(&quot;entities&quot;)&#xA;        Dim entOk As Boolean = (entTok.Type = Newtonsoft.Json.Linq.JTokenType.Array)&#xA;        If entOk Then&#xA;            For Each item As Newtonsoft.Json.Linq.JToken In entTok.Children()&#xA;                If item.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Object Then&#xA;                    entOk = False&#xA;                Else&#xA;                    Dim itemType As Newtonsoft.Json.Linq.JToken = CType(item, Newtonsoft.Json.Linq.JObject)(&quot;type&quot;)&#xA;                    Dim itemValue As Newtonsoft.Json.Linq.JToken = CType(item, Newtonsoft.Json.Linq.JObject)(&quot;value&quot;)&#xA;                    If Not (itemType IsNot Nothing AndAlso itemType.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso entityTypes.Contains(CStr(CType(itemType, Newtonsoft.Json.Linq.JValue).Value)) AndAlso truthy(itemValue)) Then entOk = False&#xA;                End If&#xA;            Next&#xA;        End If&#xA;        If Not entOk Then errs.Add(&quot;entities 형식 위반&quot;)&#xA;    End If&#xA;&#xA;    ' 4) 결과: 정의된 필드만 남긴다 (정의되지 않은 필드는 결과에 싣지 않음)&#xA;    If errs.Count &gt; 0 Then&#xA;        errorText = String.Join(&quot;; &quot;, errs)&#xA;    Else&#xA;        cleaned = New Newtonsoft.Json.Linq.JObject()&#xA;        For Each k As String In requiredKeys&#xA;            cleaned.Add(k, root(k).DeepClone())&#xA;        Next&#xA;        cleanedJson = cleaned.ToString(Newtonsoft.Json.Formatting.None)&#xA;        isValid = True&#xA;    End If&#xA;End If&#xA;&#xA;Dim outObj As New Newtonsoft.Json.Linq.JObject()&#xA;outObj(&quot;isValid&quot;) = isValid&#xA;outObj(&quot;errorText&quot;) = errorText&#xA;If isValid Then outObj(&quot;cleaned&quot;) = cleaned Else outObj(&quot;cleaned&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;resultJson = outObj.ToString(Newtonsoft.Json.Formatting.None)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="responseText">[responseText]</InArgument><OutArgument x:TypeArguments="x:Boolean" x:Key="isValid">[isValid]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="errorText">[errorText]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="cleanedJson">[cleanedJson]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="resultJson">[resultJson]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[isValid]" DisplayName="검증 통과?"><If.Then><Sequence DisplayName="성공 처리"><Assign x:TypeArguments="x:Boolean" DisplayName="성공 표시" To="[isDone]" Value="[True]" /><Assign x:TypeArguments="x:String" DisplayName="검증된 JSON 보관" To="[cleanedFinal]" Value="[cleanedJson]" /><Assign x:TypeArguments="x:Int32" DisplayName="성공한 시도 번호" To="[attemptUsed]" Value="[attempt]" /></Sequence></If.Then><If.Else><Assign x:TypeArguments="x:String" DisplayName="마지막 실패 사유 기록" To="[lastError]" Value="[errorText]" /></If.Else></If></Sequence></If.Then></If></ActivityAction></ui:ForEach.Body></ui:ForEach><ui:InvokeCode DisplayName="재시도 결과 정리 (Invoke Code)" Language="VBNet" Code="' Step3: 재시도 결과 정리  (Python: analyze.analyze 의 반환값 — (result, error, retry_count))&#xA;' In : isDone(Boolean) 성공 여부, cleanedJson(String) 성공한 시도의 검증된 JSON, lastError(String) 마지막 실패 사유,&#xA;'      maxRetry(Int32) 최대 재시도 횟수, attemptUsed(Int32) 성공한 시도 번호(0부터)&#xA;' Out: finalJson(String) {&quot;result&quot;: {...}|null, &quot;error&quot;: {&quot;stage&quot;,&quot;reason&quot;}|null, &quot;retry_count&quot;: n}&#xA;Dim finalObj As New Newtonsoft.Json.Linq.JObject()&#xA;If isDone Then&#xA;    Dim rd As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(cleanedJson))&#xA;    rd.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;    finalObj(&quot;result&quot;) = Newtonsoft.Json.Linq.JObject.Load(rd)&#xA;    finalObj(&quot;error&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    finalObj(&quot;retry_count&quot;) = attemptUsed&#xA;Else&#xA;    Dim errObj As New Newtonsoft.Json.Linq.JObject()&#xA;    errObj(&quot;stage&quot;) = &quot;VALIDATION&quot;&#xA;    errObj(&quot;reason&quot;) = &quot;재시도 &quot; &amp; maxRetry.ToString() &amp; &quot;회 후에도 실패: &quot; &amp; lastError&#xA;    finalObj(&quot;result&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    finalObj(&quot;error&quot;) = errObj&#xA;    finalObj(&quot;retry_count&quot;) = maxRetry&#xA;End If&#xA;finalJson = finalObj.ToString(Newtonsoft.Json.Formatting.None)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:Boolean" x:Key="isDone">[isDone]</InArgument><InArgument x:TypeArguments="x:String" x:Key="cleanedJson">[cleanedFinal]</InArgument><InArgument x:TypeArguments="x:String" x:Key="lastError">[lastError]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="maxRetry">[maxRetry]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="attemptUsed">[attemptUsed]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="finalJson">[finalJson]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:CreateDirectory DisplayName="결과 폴더 만들기" Output="{x:Null}" Path="[System.IO.Path.Combine(outDir, &quot;step3&quot;)]" /><ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="결과 JSON 저장" Encoding="utf-8" FileName="[System.IO.Path.Combine(outDir, &quot;step3&quot;, scName &amp; &quot;.json&quot;)]" Text="[finalJson]" /><ui:LogMessage DisplayName="로그" Level="Info" Message="[scName &amp; &quot; → 성공: &quot; &amp; isDone.ToString() &amp; &quot;, 재시도 횟수: &quot; &amp; attemptUsed.ToString()]" /></Sequence></ActivityAction></ui:ForEach.Body></ui:ForEach></Sequence>
