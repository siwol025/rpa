         End Function&#xA;&#xA;    ' 1) 응답 확인 (Python: extract_segments)&#xA;    Dim resultTok As Newtonsoft.Json.Linq.JToken = resp(&quot;result&quot;)&#xA;    If resultTok Is Nothing OrElse resultTok.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.String OrElse CStr(CType(resultTok, Newtonsoft.Json.Linq.JValue).Value) &lt;&gt; &quot;COMPLETED&quot; Then&#xA;        parseError = &quot;COMPLETED 상태가 아닌 응답: &quot; &amp; pyStr(resultTok)&#xA;    Else&#xA;        Dim labels As New System.Collections.Generic.List(Of String)&#xA;        Dim starts As New System.Collections.Generic.List(Of Double)&#xA;        Dim ends As New System.Collections.Generic.List(Of Double)&#xA;        Dim texts As New System.Collections.Generic.List(Of String)&#xA;        Dim segTok As Newtonsoft.Json.Linq.JToken = resp(&quot;segments&quot;)&#xA;        If segTok IsNot Nothing AndAlso segTok.Type = Newtonsoft.Json.Linq.JTokenType.Array Then&#xA;            For Each s As Newtonsoft.Json.Linq.JToken In segTok.Children()&#xA;                Dim so As Newtonsoft.Json.Linq.JObject = TryCast(s, Newtonsoft.Json.Linq.JObject)&#xA;                If so Is Nothing Then Throw New System.InvalidOperationException(&quot;segments 항목이 객체가 아님&quot;)&#xA;                Dim tEdit As Newtonsoft.Json.Linq.JToken = so(&quot;textEdited&quot;)&#xA;                Dim tText As Newtonsoft.Json.Linq.JToken = so(&quot;text&quot;)&#xA;                Dim txt As String = &quot;&quot;&#xA;                If tEdit IsNot Nothing AndAlso tEdit.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso CStr(CType(tEdit, Newtonsoft.Json.Linq.JValue).Value).Length &gt; 0 Then&#xA;                    txt = CStr(CType(tEdit, Newtonsoft.Json.Linq.JValue).Value)&#xA;                ElseIf tText IsNot Nothing AndAlso tText.Type = Newtonsoft.Json.Linq.JTokenType.String Then&#xA;                    txt = CStr(CType(tText, Newtonsoft.Json.Linq.JValue).Value)&#xA;                End If&#xA;                txt = txt.Trim()&#xA;                If txt.Length &gt; 0 Then&#xA;                    ' 화자 라벨: speaker.label → diarization.label → &quot;?&quot;&#xA;                    Dim lbl As String = &quot;?&quot;&#xA;                    Dim spObj As Newtonsoft.Json.Linq.JObject = TryCast(so(&quot;speaker&quot;), Newtonsoft.Json.Linq.JObject)&#xA;                    Dim dzObj As Newtonsoft.Json.Linq.JObject = TryCast(so(&quot;diarization&quot;), Newtonsoft.Json.Linq.JObject)&#xA;                    Dim spLabel As Newtonsoft.Json.Linq.JToken = Nothing&#xA;                    Dim dzLabel As Newtonsoft.Json.Linq.JToken = Nothing&#xA;                    If spObj IsNot Nothing Then spLabel = spObj(&quot;label&quot;)&#xA;                    If dzObj IsNot Nothing Then dzLabel = dzObj(&quot;label&quot;)&#xA;                    If spLabel IsNot Nothing AndAlso spLabel.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null AndAlso Not (spLabel.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso CStr(CType(spLabel, Newtonsoft.Json.Linq.JValue).Value) = &quot;&quot;) Then&#xA;                        lbl = pyStr(spLabel)&#xA;                    ElseIf dzLabel IsNot Nothing AndAlso dzLabel.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null AndAlso Not (dzLabel.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso CStr(CType(dzLabel, Newtonsoft.Json.Linq.JValue).Value) = &quot;&quot;) Then&#xA;                        lbl = pyStr(dzLabel)&#xA;                    End If&#xA;                    ' 시작·끝 (ms → 초, 소수 2자리). 없으면 0&#xA;                    Dim ms2 As Double() = New Double() {0.0, 0.0}&#xA;                    Dim keys2 As String() = New String() {&quot;start&quot;, &quot;end&quot;}&#xA;                    For k As Integer = 0 To 1&#xA;                        Dim vt As Newtonsoft.Json.Linq.JToken = so(keys2(k))&#xA;                        If vt IsNot Nothing Then&#xA;                            If vt.Type = Newtonsoft.Json.Linq.JTokenType.Integer OrElse vt.Type = Newtonsoft.Json.Linq.JTokenType.Float Then&#xA;                                ms2(k) = CDbl(CType(vt, Newtonsoft.Json.Linq.JValue).Value)&#xA;                            ElseIf vt.Type = Newtonsoft.Json.Linq.JTokenType.String Then&#xA;                                Dim parsed As Double&#xA;                                If Not System.Double.TryParse(CStr(CType(vt, Newtonsoft.Json.Linq.JValue).Value), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, parsed) Then&#xA;                                    Throw New System.FormatException(&quot;could not convert string to float: '&quot; &amp; CStr(CType(vt, Newtonsoft.Json.Linq.JValue).Value) &amp; &quot;'&quot;)&#xA;                                End If&#xA;                                ms2(k) = parsed&#xA;                            Else&#xA;                                Throw New System.FormatException(&quot;float() argument must be a string or a real number, not '&quot; &amp; If(vt.Type = Newtonsoft.Json.Linq.JTokenType.Null, &quot;NoneType&quot;, vt.Type.ToString()) &amp; &quot;'&quot;)&#xA;                            End If&#xA;                        End If&#xA;                    Next&#xA;                    labels.Add(lbl)&#xA;                    starts.Add(roundSec(ms2(0)))&#xA;                    ends.Add(roundSec(ms2(1)))&#xA;                    texts.Add(txt)&#xA;                End If&#xA;            Next&#xA;        End If&#xA;        If texts.Count = 0 Then&#xA;            parseError = &quot;발화가 없음&quot;&#xA;        Else&#xA;            ' 2) 같은 화자의 연속 발화 병합 (Python: merge_consecutive)&#xA;            Dim mLabels As New System.Collections.Generic.List(Of String)&#xA;            Dim mStarts As New System.Collections.Generic.List(Of Double)&#xA;            Dim mEnds As New System.Collections.Generic.List(Of Double)&#xA;            Dim mTexts As New System.Collections.Generic.List(Of String)&#xA;            For i As Integer = 0 To texts.Count - 1&#xA;                If mLabels.Count &gt; 0 AndAlso mLabels(mLabels.Count - 1) = labels(i) Then&#xA;                    mTexts(mTexts.Count - 1) = mTexts(mTexts.Count - 1) &amp; &quot; &quot; &amp; texts(i)&#xA;                    mEnds(mEnds.Count - 1) = ends(i)&#xA;                Else&#xA;                    mLabels.Add(labels(i))&#xA;                    mStarts.Add(starts(i))&#xA;                    mEnds.Add(ends(i))&#xA;                    mTexts.Add(texts(i))&#xA;                End If&#xA;            Next&#xA;&#xA;            ' 3) 화자 라벨 → 상담원/고객 (Python: assign_roles)&#xA;            Dim greetingKeywords As String() = New String() {&quot;고객지원센터&quot;, &quot;고객센터&quot;, &quot;상담원&quot;, &quot;무엇을 도와&quot;}&#xA;            Dim agentPhrases As String() = New String() {&quot;고객지원센터&quot;, &quot;고객센터입니다&quot;, &quot;무엇을 도와&quot;, &quot;도와드리&quot;, &quot;도와 드리&quot;, &quot;안내해 드리&quot;, &quot;안내드리&quot;, &quot;확인해 보겠&quot;, &quot;확인해보겠&quot;, &quot;죄송합니다&quot;, &quot;보내 드리겠&quot;, &quot;말씀해 주&quot;, &quot;확인 후&quot;}&#xA;            Dim uniq As New System.Collections.Generic.List(Of String)&#xA;            For Each lb As String In mLabels&#xA;                If Not uniq.Contains(lb) Then uniq.Add(lb)&#xA;            Next&#xA;            Dim score As New System.Collections.Generic.Dictionary(Of String, Integer)&#xA;            Dim firstUtt As New System.Collections.Generic.Dictionary(Of String, String)&#xA;            For Each lb As String In uniq&#xA;                score(lb) = 0&#xA;            Next&#xA;            For i As Integer = 0 To mTexts.Count - 1&#xA;                If Not firstUtt.ContainsKey(mLabels(i)) Then firstUtt(mLabels(i)) = mTexts(i)&#xA;                For Each ph As String In agentPhrases&#xA;                    Dim pos As Integer = mTexts(i).IndexOf(ph, System.StringComparison.Ordinal)&#xA;                    Do While pos &gt;= 0&#xA;                        score(mLabels(i)) = score(mLabels(i)) + 1&#xA;                        pos = mTexts(i).IndexOf(ph, pos + ph.Length, System.StringComparison.Ordinal)&#xA;                    Loop&#xA;                Next&#xA;            Next&#xA;            Dim roles As New System.Collections.Generic.Dictionary(Of String, String)&#xA;            Dim conf As String&#xA;            If uniq.Count &lt; 2 Then&#xA;                roles(uniq(0)) = &quot;UNKNOWN&quot;&#xA;                conf = &quot;LOW&quot;&#xA;            Else&#xA;                Dim firstL As String = uniq(0)&#xA;                Dim secondL As String = uniq(1)&#xA;                Dim greeters As New System.Collections.Generic.List(Of String)&#xA;                For Each lb As String In uniq&#xA;                    Dim isG As Boolean = False&#xA;                    For Each kw As String In greetingKeywords&#xA;                        If firstUtt(lb).Contains(kw) Then isG = True&#xA;                    Next&#xA;                    If isG Then greeters.Add(lb)&#xA;                Next&#xA;                If greeters.Count = 1 AndAlso uniq.Count = 2 Then&#xA;                    Dim ag As String = greeters(0)&#xA;                    Dim cu As String = If(ag = firstL, secondL, firstL)&#xA;                    roles(ag) = &quot;AGENT&quot;&#xA;                    roles(cu) = &quot;CUSTOMER&quot;&#xA;                    conf = &quot;HIGH&quot;&#xA;                Else&#xA;                    Dim a As Integer = score(firstL)&#xA;                    Dim b As Integer = score(secondL)&#xA;                    Dim agent As String&#xA;                    If System.Math.Abs(a - b) &gt;= 2 Then&#xA;                        agent = If(a &gt; b, firstL, secondL)&#xA;                        conf = If(agent = firstL, &quot;HIGH&quot;, &quot;LOW&quot;)&#xA;                    Else&#xA;                        agent = firstL&#xA;                        conf = If(a &gt; b, &quot;HIGH&quot;, &quot;LOW&quot;)&#xA;                    End If&#xA;                    Dim customer As String = If(agent = firstL, secondL, firstL)&#xA;                    roles(agent) = &quot;AGENT&quot;&#xA;                    roles(customer) = &quot;CUSTOMER&quot;&#xA;                    For i As Integer = 2 To uniq.Count - 1&#xA;                        roles(uniq(i)) = &quot;UNKNOWN&quot;&#xA;                        conf = &quot;LOW&quot;&#xA;                    Next&#xA;                End If&#xA;            End If&#xA;&#xA;            ' 4) 전사 객체와 '[상담원] … / [고객] …' 형식 전문&#xA;            Dim roleLabel As New System.Collections.Generic.Dictionary(Of String, String)&#xA;            roleLabel(&quot;AGENT&quot;) = &quot;상담원&quot;&#xA;            roleLabel(&quot;CUSTOMER&quot;) = &quot;고객&quot;&#xA;            roleLabel(&quot;UNKNOWN&quot;) = &quot;알수없음&quot;&#xA;            Dim segsOut As New Newtonsoft.Json.Linq.JArray()&#xA;            Dim lines As New System.Collections.Generic.List(Of String)&#xA;            For i As Integer = 0 To mTexts.Count - 1&#xA;                Dim o As New Newtonsoft.Json.Linq.JObject()&#xA;                o(&quot;speaker&quot;) = roles(mLabels(i))&#xA;                o(&quot;start_sec&quot;) = mStarts(i)&#xA;                o(&quot;end_sec&quot;) = mEnds(i)&#xA;                o(&quot;text&quot;) = mTexts(i)&#xA;                segsOut.Add(o)&#xA;                lines.Add(&quot;[&quot; &amp; roleLabel(roles(mLabels(i))) &amp; &quot;] &quot; &amp; mTexts(i))&#xA;            Next&#xA;            Dim trOut As New Newtonsoft.Json.Linq.JObject()&#xA;            trOut(&quot;full_text&quot;) = String.Join(vbLf, lines)&#xA;            trOut(&quot;segments&quot;) = segsOut&#xA;            trOut(&quot;speaker_confidence&quot;) = conf&#xA;            transcriptJson = trOut.ToString(Newtonsoft.Json.Formatting.None)&#xA;        End If&#xA;    End If&#xA;Catch ex As System.Exception&#xA;    transcriptJson = &quot;&quot;&#xA;    If TypeOf ex Is Newtonsoft.Json.JsonException Then&#xA;        parseError = &quot;응답 JSON을 읽을 수 없음(JSONDecodeError)&quot;&#xA;    Else&#xA;        parseError = ex.Message&#xA;    End If&#xA;End Try&#xA;&#xA;Dim resultObj As New Newtonsoft.Json.Linq.JObject()&#xA;If transcriptJson &lt;&gt; &quot;&quot; Then&#xA;    Dim rdT As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(transcriptJson))&#xA;    rdT.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;    resultObj(&quot;transcript&quot;) = Newtonsoft.Json.Linq.JObject.Load(rdT)&#xA;Else&#xA;    resultObj(&quot;transcript&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;End If&#xA;resultObj(&quot;error&quot;) = parseError&#xA;resultJson = resultObj.ToString(Newtonsoft.Json.Formatting.None)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="sttJson">[sttJson]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="transcriptJson">[transcriptJson]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="parseError">[parseError]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="resultJson">[parseResultJson]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[parseError &lt;&gt; &quot;&quot;]" DisplayName="파싱 실패?"><If.Then><Sequence DisplayName="STT 단계 실패로 기록"><Assign x:TypeArguments="x:String" DisplayName="실패 단계" To="[sttStage]" Value="[&quot;STT&quot;]" /><Assign x:TypeArguments="x:String" DisplayName="실패 사유" To="[sttError]" Value="[parseError]" /></Sequence></If.Then></If></Sequence></If.Then></If><If Condition="[sttError = &quot;&quot;]" DisplayName="STT·파싱 성공했으면 마스킹 → 분석"><If.Then><Sequence DisplayName="마스킹·분석"><Assign x:TypeArguments="x:String" DisplayName="현재 단계" To="[phase]" Value="[&quot;PII&quot;]" /><ui:InvokeCode DisplayName="개인정보 마스킹 (Invoke Code)" Language="VBNet" Code="' Step4: 개인정보(PII) 마스킹  (Python: mask_pii.mask_transcript / mask_text)&#xA;' In : transcriptJson(String) {&quot;full_text&quot;,&quot;segments&quot;:[{&quot;speaker&quot;,&quot;start_sec&quot;,&quot;end_sec&quot;,&quot;text&quot;}],&quot;speaker_confidence&quot;}  (parse_clova 결과)&#xA;' Out: maskedJson(String) {&quot;transcript&quot;: 마스킹된 전사, &quot;pii&quot;: {&quot;masked&quot;: true, &quot;counts&quot;: {...}}},&#xA;'      maskedFullText(String) 마스킹된 전문(&quot;[상담원] ...\n[고객] ...&quot;), maskError(String; 성공이면 &quot;&quot;)&#xA;maskedJson = &quot;&quot;&#xA;maskedFullText = &quot;&quot;&#xA;maskError = &quot;&quot;&#xA;Dim counts As New System.Collections.Generic.Dictionary(Of String, Integer)&#xA;For Each ck As String In New String() {&quot;phone&quot;, &quot;rrn&quot;, &quot;card&quot;, &quot;account&quot;, &quot;email&quot;, &quot;name&quot;, &quot;address&quot;, &quot;password&quot;, &quot;birth&quot;}&#xA;    counts(ck) = 0&#xA;Next&#xA;&#xA;' 적용 순서가 중요하다 (긴/구체적인 패턴 먼저). Python 의 RULES 와 같은 순서·같은 패턴.&#xA;Dim prov As String = &quot;(?:서울특별시|서울시|서울|부산광역시|부산|대구광역시|대구|인천광역시|인천|광주광역시|광주|대전광역시|대전|&quot; &amp; _&#xA;    &quot;울산광역시|울산|세종특별자치시|세종|경기도|경기|강원특별자치도|강원도|강원|충청북도|충북|충청남도|충남|&quot; &amp; _&#xA;    &quot;전북특별자치도|전라북도|전북|전라남도|전남|경상북도|경북|경상남도|경남|제주특별자치도|제주도|제주)&quot;&#xA;Dim kinds As String() = New String() {&quot;address&quot;, &quot;rrn&quot;, &quot;card&quot;, &quot;phone&quot;, &quot;email&quot;, &quot;account&quot;, &quot;birth&quot;}&#xA;Dim tokens As String() = New String() {&quot;[ADDRESS]&quot;, &quot;[RRN]&quot;, &quot;[CARD]&quot;, &quot;[PHONE]&quot;, &quot;[EMAIL]&quot;, &quot;[ACCOUNT]&quot;, &quot;[BIRTH]&quot;}&#xA;Dim patterns As String() = New String() { _&#xA;    prov &amp; &quot;\s*[가-힣]{1,6}[시군구]\s+(?:[가-힣0-9\-]+\s+){0,5}[가-힣0-9\-]*\d[가-힣0-9\-]*&quot;, _&#xA;    &quot;(?&lt;!\d)\d{6}\s*[-–]\s*[1-4]\d{6}(?!\d)&quot;, _&#xA;    &quot;(?&lt;!\d)\d{4}[-\s]\d{4}[-\s]\d{4}[-\s]\d{4}(?!\d)&quot;, _&#xA;    &quot;(?&lt;!\d)(?:01[016789][-.\s]?\d{3,4}[-.\s]?\d{4}|0\d{1,2}[-.\s]\d{3,4}[-.\s]\d{4})(?!\d)&quot;, _&#xA;    &quot;[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}&quot;, _&#xA;    &quot;(?&lt;!\d)\d{2,6}-\d{2,6}-\d{4,8}(?:-\d{1,3})?(?!\d)&quot;, _&#xA;    &quot;(?&lt;!\d)(?:19|20)?\d{2}년생&quot;}&#xA;' 비밀번호: 앞 문맥('비밀번호는')은 남기고 값 어절들만 치환&#xA;Dim pwTok As String = &quot;(?:[A-Za-z0-9]+|느낌표|골뱅이|별표|샵|언더바|물결|대시|하이픈)[가-힣]{0,2}&quot;&#xA;Dim passwordPattern As String = &quot;(비밀\s?번호(?:는|가|를|도)?\s*)(&quot; &amp; pwTok &amp; &quot;(?:\s+&quot; &amp; pwTok &amp; &quot;)*)&quot;&#xA;' 이름: 그룹 1(앞 문맥)은 남기고 그룹 2(이름)만 치환&#xA;Dim namePatterns As String() = New String() { _&#xA;    &quot;(상담원\s*)([가-힣]{2,4})(?=\s*(?:입니다|이에요|예요|이라고))&quot;, _&#xA;    &quot;((?:제\s*이름은|성함은|이름은|저는)\s*)([가-힣]{2,4})(?=\s*(?:입니다|이에요|예요|이라고|씨|님|인데))&quot;}&#xA;Dim nameStopWords As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;고객&quot;, &quot;상담원&quot;, &quot;담당자&quot;, &quot;회원&quot;, &quot;관리자&quot;})&#xA;&#xA;Dim pwEval As System.Text.RegularExpressions.MatchEvaluator = Function(m As System.Text.RegularExpressions.Match) As String&#xA;                                                                  Return m.Groups(1).Value &amp; &quot;[PASSWORD]&quot;&#xA;                                                              End Function&#xA;Dim nameEval As System.Text.RegularExpressions.MatchEvaluator = Function(m As System.Text.RegularExpressions.Match) As String&#xA;                                                                    Dim nm As String&#xA;                                                                    If nameStopWords.Contains(m.Groups(2).Value) Then&#xA;                                                                        nm = m.Value&#xA;                                                                    Else&#xA;                                                                        counts(&quot;name&quot;) = counts(&quot;name&quot;) + 1&#xA;                                                                        nm = m.Groups(1).Value &amp; &quot;[NAME]&quot;&#xA;                                                                    End If&#xA;                                                                    Return nm&#xA;                                                                End Function&#xA;Dim maskText As System.Func(Of String, String) = Function(t As String) As String&#xA;                                                     Dim cur As String = t&#xA;                                                     For i As Integer = 0 To kinds.Length - 1&#xA;                                                         counts(kinds(i)) = counts(kinds(i)) + System.Text.RegularExpressions.Regex.Matches(cur, patterns(i)).Count&#xA;                                                         cur = System.Text.RegularExpressions.Regex.Replace(cur, patterns(i), tokens(i))&#xA;                                                     Next&#xA;                                                     counts(&quot;password&quot;) = counts(&quot;password&quot;) + System.Text.RegularExpressions.Regex.Matches(cur, passwordPattern).Count&#xA;                                                     cur = System.Text.RegularExpressions.Regex.Replace(cur, passwordPattern, pwEval)&#xA;                                                     For Each np As String In namePatterns&#xA;                                                         cur = System.Text.RegularExpressions.Regex.Replace(cur, np, nameEval)&#xA;                                                     Next&#xA;                                                     Return cur&#xA;                                                 End Function&#xA;&#xA;Try&#xA;    Dim rd As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(transcriptJson))&#xA;    rd.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;    Dim tr As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Load(rd)&#xA;    Dim roleLabel As New System.Collections.Generic.Dictionary(Of String, String)&#xA;    roleLabel(&quot;AGENT&quot;) = &quot;상담원&quot;&#xA;    roleLabel(&quot;CUSTOMER&quot;) = &quot;고객&quot;&#xA;    roleLabel(&quot;UNKNOWN&quot;) = &quot;알수없음&quot;&#xA;    Dim segsOut As New Newtonsoft.Json.Linq.JArray()&#xA;    Dim lines As New System.Collections.Generic.List(Of String)&#xA;    For Each segTok As Newtonsoft.Json.Linq.JToken In tr(&quot;segments&quot;).Children()&#xA;        Dim seg As Newtonsoft.Json.Linq.JObject = CType(segTok.DeepClone(), Newtonsoft.Json.Linq.JObject)&#xA;        Dim masked As String = maskText(seg.Value(Of String)(&quot;text&quot;))&#xA;        seg(&quot;text&quot;) = masked&#xA;        segsOut.Add(seg)&#xA;        lines.Add(&quot;[&quot; &amp; roleLabel(seg.Value(Of String)(&quot;speaker&quot;)) &amp; &quot;] &quot; &amp; masked)&#xA;    Next&#xA;    maskedFullText = String.Join(vbLf, lines)&#xA;&#xA;    Dim trOut As New Newtonsoft.Json.Linq.JObject()&#xA;    trOut(&quot;full_text&quot;) = maskedFullText&#xA;    trOut(&quot;segments&quot;) = segsOut&#xA;    If tr(&quot;speaker_confidence&quot;) Is Nothing Then&#xA;        trOut(&quot;speaker_confidence&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    Else&#xA;        trOut(&quot;speaker_confidence&quot;) = tr(&quot;speaker_confidence&quot;).DeepClone()&#xA;    End If&#xA;    Dim countsOut As New Newtonsoft.Json.Linq.JObject()&#xA;    For Each ck As String In New String() {&quot;phone&quot;, &quot;rrn&quot;, &quot;card&quot;, &quot;account&quot;, &quot;email&quot;, &quot;name&quot;, &quot;address&quot;, &quot;password&quot;, &quot;birth&quot;}&#xA;        countsOut(ck) = counts(ck)&#xA;    Next&#xA;    Dim piiOut As New Newtonsoft.Json.Linq.JObject()&#xA;    piiOut(&quot;masked&quot;) = True&#xA;    piiOut(&quot;counts&quot;) = countsOut&#xA;    Dim outObj As New Newtonsoft.Json.Linq.JObject()&#xA;    outObj(&quot;transcript&quot;) = trOut&#xA;    outObj(&quot;pii&quot;) = piiOut&#xA;    maskedJson = outObj.ToString(Newtonsoft.Json.Formatting.None)&#xA;Catch ex As System.Exception&#xA;    maskError = &quot;마스킹 실패(&quot; &amp; ex.GetType().Name &amp; &quot;)&quot;&#xA;    maskedJson = &quot;&quot;&#xA;    maskedFullText = &quot;&quot;&#xA;End Try"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="transcriptJson">[transcriptJson]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="maskedJson">[maskedJson]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="maskedFullText">[maskedFullText]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="maskError">[maskError]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[maskError &lt;&gt; &quot;&quot;]" DisplayName="마스킹 실패?"><If.Then><Throw DisplayName="마스킹 실패" Exception="[New System.InvalidOperationException(maskError)]" /></If.Then></If><Assign x:TypeArguments="x:String" DisplayName="현재 단계" To="[phase]" Value="[&quot;GENAI&quot;]" /><ui:InvokeCode DisplayName="프롬프트 조립 (Invoke Code)" Language="VBNet" Code="' Step1: 프롬프트 조립  (Python: analyze.build_prompt)&#xA;' In : promptText(String) 프롬프트 파일 전체, transcriptText(String) 마스킹된 전사본&#xA;' Out: systemPrompt, userPrompt, buildError(String, 성공이면 빈 문자열)&#xA;buildError = &quot;&quot;&#xA;systemPrompt = &quot;&quot;&#xA;userPrompt = &quot;&quot;&#xA;Dim keptLines As New System.Collections.Generic.List(Of String)&#xA;For Each rawLine As String In System.Text.RegularExpressions.Regex.Split(If(promptText, &quot;&quot;), &quot;\r\n|\n|\r&quot;)&#xA;    ' 설명용 '#' 줄 제외 (Python: not l.lstrip().startswith(&quot;#&quot;))&#xA;    If Not rawLine.TrimStart().StartsWith(&quot;#&quot;, System.StringComparison.Ordinal) Then keptLines.Add(rawLine)&#xA;Next&#xA;Dim promptBody As String = String.Join(vbLf, keptLines)&#xA;Dim blockMatch As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(promptBody, &quot;\[SYSTEM\](.*?)\[USER TEMPLATE\](.*)&quot;, System.Text.RegularExpressions.RegexOptions.Singleline)&#xA;If Not blockMatch.Success Then&#xA;    buildError = &quot;prompt 파일에 [SYSTEM]/[USER TEMPLATE] 블록이 없음&quot;&#xA;Else&#xA;    systemPrompt = blockMatch.Groups(1).Value.Trim()&#xA;    userPrompt = blockMatch.Groups(2).Value.Trim().Replace(&quot;{{TRANSCRIPT}}&quot;, If(transcriptText, &q