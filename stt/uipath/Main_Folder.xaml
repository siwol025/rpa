;    Try&#xA;        Dim rd As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(txt.Substring(sIdx, eIdx - sIdx + 1)))&#xA;        rd.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;        root = Newtonsoft.Json.Linq.JObject.Load(rd)&#xA;        If rd.Read() Then parseLabel = &quot;JSONDecodeError&quot;&#xA;    Catch ex As System.Exception&#xA;        parseLabel = &quot;JSONDecodeError&quot;&#xA;    End Try&#xA;End If&#xA;&#xA;If parseLabel &lt;&gt; &quot;&quot; Then&#xA;    errorText = &quot;응답 파싱 실패(&quot; &amp; parseLabel &amp; &quot;)&quot;&#xA;Else&#xA;    Dim requiredKeys As String() = New String() {&quot;type&quot;, &quot;type_confidence&quot;, &quot;customer_company&quot;, &quot;customer_question&quot;, &quot;agent_action&quot;, &quot;summary&quot;, &quot;follow_up_required&quot;, &quot;follow_up&quot;, &quot;keywords&quot;, &quot;entities&quot;}&#xA;    Dim typeCodes As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;INQUIRY&quot;, &quot;COMPLAINT&quot;, &quot;SUGGESTION&quot;, &quot;TRAINING&quot;, &quot;OTHER&quot;})&#xA;    Dim entityTypes As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;PRODUCT&quot;, &quot;ORG&quot;, &quot;DATE&quot;, &quot;AMOUNT&quot;, &quot;REF_NO&quot;, &quot;OTHER&quot;})&#xA;&#xA;    ' Python 의 repr 처럼 값을 표시 (오류 메시지 호환용)&#xA;    Dim pyRepr As System.Func(Of Newtonsoft.Json.Linq.JToken, String) = Function(t As Newtonsoft.Json.Linq.JToken) As String&#xA;                                                                             Dim r As String&#xA;                                                                             Select Case t.Type&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Null&#xA;                                                                                     r = &quot;None&quot;&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.String&#xA;                                                                                     Dim sv As String = CStr(CType(t, Newtonsoft.Json.Linq.JValue).Value)&#xA;                                                                                     If sv.Contains(&quot;'&quot;) AndAlso Not sv.Contains(&quot;&quot;&quot;&quot;) Then&#xA;                                                                                         r = &quot;&quot;&quot;&quot; &amp; sv &amp; &quot;&quot;&quot;&quot;&#xA;                                                                                     Else&#xA;                                                                                         r = &quot;'&quot; &amp; sv.Replace(&quot;\&quot;, &quot;\\&quot;).Replace(&quot;'&quot;, &quot;\'&quot;).Replace(vbLf, &quot;\n&quot;).Replace(vbCr, &quot;\r&quot;).Replace(vbTab, &quot;\t&quot;) &amp; &quot;'&quot;&#xA;                                                                                     End If&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Boolean&#xA;                                                                                     r = If(CBool(CType(t, Newtonsoft.Json.Linq.JValue).Value), &quot;True&quot;, &quot;False&quot;)&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Integer&#xA;                                                                                     r = System.Convert.ToString(CType(t, Newtonsoft.Json.Linq.JValue).Value, System.Globalization.CultureInfo.InvariantCulture)&#xA;                                                                                 Case Newtonsoft.Json.Linq.JTokenType.Float&#xA;                                                                                     Dim dv As Double = CDbl(CType(t, Newtonsoft.Json.Linq.JValue).Value)&#xA;                                                                                     r = dv.ToString(&quot;R&quot;, System.Globalization.CultureInfo.InvariantCulture)&#xA;                                                                                     If dv = System.Math.Floor(dv) AndAlso Not r.Contains(&quot;E&quot;) Then r = r &amp; &quot;.0&quot;&#xA;                                                                                 Case Else&#xA;                                                                                     r = t.ToString(Newtonsoft.Json.Formatting.None)&#xA;                                                                             End Select&#xA;                                                                             Return r&#xA;                                                                         End Function&#xA;    ' Python 의 truthiness (not x.get(&quot;value&quot;) 판정용)&#xA;    Dim truthy As System.Func(Of Newtonsoft.Json.Linq.JToken, Boolean) = Function(t As Newtonsoft.Json.Linq.JToken) As Boolean&#xA;                                                                              Dim r As Boolean = False&#xA;                                                                              If t IsNot Nothing Then&#xA;                                                                                  Select Case t.Type&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Null&#xA;                                                                                          r = False&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.String&#xA;                                                                                          r = CStr(CType(t, Newtonsoft.Json.Linq.JValue).Value).Length &gt; 0&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Boolean&#xA;                                                                                          r = CBool(CType(t, Newtonsoft.Json.Linq.JValue).Value)&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Integer, Newtonsoft.Json.Linq.JTokenType.Float&#xA;                                                                                          r = CDbl(CType(t, Newtonsoft.Json.Linq.JValue).Value) &lt;&gt; 0&#xA;                                                                                      Case Newtonsoft.Json.Linq.JTokenType.Array, Newtonsoft.Json.Linq.JTokenType.Object&#xA;                                                                                          r = t.HasValues&#xA;                                                                                      Case Else&#xA;                                                                                          r = True&#xA;                                                                                  End Select&#xA;                                                                              End If&#xA;                                                                              Return r&#xA;                                                                          End Function&#xA;&#xA;    ' 2) 필수 키 (하나라도 없으면 거기서 끝, Python: errs 가 있으면 즉시 반환)&#xA;    For Each k As String In requiredKeys&#xA;        If root(k) Is Nothing Then errs.Add(k &amp; &quot; 누락&quot;)&#xA;    Next&#xA;&#xA;    ' 3) 값 검증 (Python: validate)&#xA;    If errs.Count = 0 Then&#xA;        Dim typeTok As Newtonsoft.Json.Linq.JToken = root(&quot;type&quot;)&#xA;        If Not (typeTok.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso typeCodes.Contains(CStr(CType(typeTok, Newtonsoft.Json.Linq.JValue).Value))) Then&#xA;            errs.Add(&quot;type enum 위반: &quot; &amp; pyRepr(typeTok))&#xA;        End If&#xA;&#xA;        Dim confTok As Newtonsoft.Json.Linq.JToken = root(&quot;type_confidence&quot;)&#xA;        Dim confOk As Boolean = False&#xA;        If confTok.Type = Newtonsoft.Json.Linq.JTokenType.Integer OrElse confTok.Type = Newtonsoft.Json.Linq.JTokenType.Float Then&#xA;            Dim cv As Double = CDbl(CType(confTok, Newtonsoft.Json.Linq.JValue).Value)&#xA;            confOk = (cv &gt;= 0.0 AndAlso cv &lt;= 1.0)&#xA;        End If&#xA;        If Not confOk Then errs.Add(&quot;type_confidence 범위 위반&quot;)&#xA;&#xA;        Dim sumTok As Newtonsoft.Json.Linq.JToken = root(&quot;summary&quot;)&#xA;        Dim sumOk As Boolean = False&#xA;        If sumTok.Type = Newtonsoft.Json.Linq.JTokenType.String Then&#xA;            Dim sl As Integer = CStr(CType(sumTok, Newtonsoft.Json.Linq.JValue).Value).Length&#xA;            sumOk = (sl &gt; 0 AndAlso sl &lt;= 300)&#xA;        End If&#xA;        If Not sumOk Then errs.Add(&quot;summary 비었거나 300자 초과&quot;)&#xA;&#xA;        For Each k As String In New String() {&quot;customer_question&quot;, &quot;agent_action&quot;}&#xA;            Dim tk As Newtonsoft.Json.Linq.JToken = root(k)&#xA;            If tk.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xA;                Dim okLen As Boolean = False&#xA;                If tk.Type = Newtonsoft.Json.Linq.JTokenType.String Then&#xA;                    Dim ln As Integer = CStr(CType(tk, Newtonsoft.Json.Linq.JValue).Value).Length&#xA;                    okLen = (ln &gt; 0 AndAlso ln &lt;= 200)&#xA;                End If&#xA;                If Not okLen Then errs.Add(k &amp; &quot; 길이/형식 위반&quot;)&#xA;            End If&#xA;        Next&#xA;&#xA;        If root(&quot;follow_up_required&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Boolean Then errs.Add(&quot;follow_up_required는 boolean&quot;)&#xA;&#xA;        Dim kwTok As Newtonsoft.Json.Linq.JToken = root(&quot;keywords&quot;)&#xA;        If Not (kwTok.Type = Newtonsoft.Json.Linq.JTokenType.Array AndAlso CType(kwTok, Newtonsoft.Json.Linq.JArray).Count &lt;= 5) Then errs.Add(&quot;keywords는 최대 5개 배열&quot;)&#xA;&#xA;        Dim entTok As Newtonsoft.Json.Linq.JToken = root(&quot;entities&quot;)&#xA;        Dim entOk As Boolean = (entTok.Type = Newtonsoft.Json.Linq.JTokenType.Array)&#xA;        If entOk Then&#xA;            For Each item As Newtonsoft.Json.Linq.JToken In entTok.Children()&#xA;                If item.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Object Then&#xA;                    entOk = False&#xA;                Else&#xA;                    Dim itemType As Newtonsoft.Json.Linq.JToken = CType(item, Newtonsoft.Json.Linq.JObject)(&quot;type&quot;)&#xA;                    Dim itemValue As Newtonsoft.Json.Linq.JToken = CType(item, Newtonsoft.Json.Linq.JObject)(&quot;value&quot;)&#xA;                    If Not (itemType IsNot Nothing AndAlso itemType.Type = Newtonsoft.Json.Linq.JTokenType.String AndAlso entityTypes.Contains(CStr(CType(itemType, Newtonsoft.Json.Linq.JValue).Value)) AndAlso truthy(itemValue)) Then entOk = False&#xA;                End If&#xA;            Next&#xA;        End If&#xA;        If Not entOk Then errs.Add(&quot;entities 형식 위반&quot;)&#xA;    End If&#xA;&#xA;    ' 4) 결과: 정의된 필드만 남긴다 (정의되지 않은 필드는 결과에 싣지 않음)&#xA;    If errs.Count &gt; 0 Then&#xA;        errorText = String.Join(&quot;; &quot;, errs)&#xA;    Else&#xA;        cleaned = New Newtonsoft.Json.Linq.JObject()&#xA;        For Each k As String In requiredKeys&#xA;            cleaned.Add(k, root(k).DeepClone())&#xA;        Next&#xA;        cleanedJson = cleaned.ToString(Newtonsoft.Json.Formatting.None)&#xA;        isValid = True&#xA;    End If&#xA;End If&#xA;&#xA;Dim outObj As New Newtonsoft.Json.Linq.JObject()&#xA;outObj(&quot;isValid&quot;) = isValid&#xA;outObj(&quot;errorText&quot;) = errorText&#xA;If isValid Then outObj(&quot;cleaned&quot;) = cleaned Else outObj(&quot;cleaned&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;resultJson = outObj.ToString(Newtonsoft.Json.Formatting.None)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="responseText">[llmResponse]</InArgument><OutArgument x:TypeArguments="x:Boolean" x:Key="isValid">[isValid]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="errorText">[errorText]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="cleanedJson">[cleanedJson]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="resultJson">[resultJson]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[isValid]" DisplayName="검증 통과?"><If.Then><Sequence DisplayName="성공 처리"><Assign x:TypeArguments="x:Boolean" DisplayName="성공 표시" To="[isDone]" Value="[True]" /><Assign x:TypeArguments="x:String" DisplayName="검증된 JSON 보관" To="[cleanedFinal]" Value="[cleanedJson]" /><Assign x:TypeArguments="x:Int32" DisplayName="성공한 시도 번호" To="[attemptUsed]" Value="[attempt]" /></Sequence></If.Then><If.Else><Assign x:TypeArguments="x:String" DisplayName="마지막 실패 사유 기록" To="[lastError]" Value="[errorText]" /></If.Else></If></Sequence></If.Then></If></Sequence></If.Then></If></ActivityAction></ui:ForEach.Body></ui:ForEach><ui:InvokeCode DisplayName="재시도 결과 정리 (Invoke Code)" Language="VBNet" Code="' Step3: 재시도 결과 정리  (Python: analyze.analyze 의 반환값 — (result, error, retry_count))&#xA;' In : isDone(Boolean) 성공 여부, cleanedJson(String) 성공한 시도의 검증된 JSON, lastError(String) 마지막 실패 사유,&#xA;'      maxRetry(Int32) 최대 재시도 횟수, attemptUsed(Int32) 성공한 시도 번호(0부터)&#xA;' Out: finalJson(String) {&quot;result&quot;: {...}|null, &quot;error&quot;: {&quot;stage&quot;,&quot;reason&quot;}|null, &quot;retry_count&quot;: n}&#xA;Dim finalObj As New Newtonsoft.Json.Linq.JObject()&#xA;If isDone Then&#xA;    Dim rd As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(cleanedJson))&#xA;    rd.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;    finalObj(&quot;result&quot;) = Newtonsoft.Json.Linq.JObject.Load(rd)&#xA;    finalObj(&quot;error&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    finalObj(&quot;retry_count&quot;) = attemptUsed&#xA;Else&#xA;    Dim errObj As New Newtonsoft.Json.Linq.JObject()&#xA;    errObj(&quot;stage&quot;) = &quot;VALIDATION&quot;&#xA;    errObj(&quot;reason&quot;) = &quot;재시도 &quot; &amp; maxRetry.ToString() &amp; &quot;회 후에도 실패: &quot; &amp; lastError&#xA;    finalObj(&quot;result&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    finalObj(&quot;error&quot;) = errObj&#xA;    finalObj(&quot;retry_count&quot;) = maxRetry&#xA;End If&#xA;finalJson = finalObj.ToString(Newtonsoft.Json.Formatting.None)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:Boolean" x:Key="isDone">[isDone]</InArgument><InArgument x:TypeArguments="x:String" x:Key="cleanedJson">[cleanedFinal]</InArgument><InArgument x:TypeArguments="x:String" x:Key="lastError">[lastError]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="maxRetry">[maxRetry]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="attemptUsed">[attemptUsed]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="finalJson">[finalJson]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode></Sequence></If.Then></If></Sequence></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="s:Exception"><ActivityAction x:TypeArguments="s:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument><Sequence DisplayName="예외를 실패로 기록"><Assign x:TypeArguments="x:String" DisplayName="실패 단계 = 진행 중이던 단계" To="[sttStage]" Value="[phase]" /><Assign x:TypeArguments="x:String" DisplayName="실패 사유" To="[sttError]" Value="[&quot;처리 중 예외(&quot; &amp; exception.GetType().Name &amp; &quot;)&quot;]" /></Sequence></ActivityAction></Catch></TryCatch.Catches></TryCatch><ui:InvokeCode DisplayName="최종 JSON 조립·상태 판정 (Invoke Code)" Language="VBNet" Code="' Step5: 최종 결과 JSON 조립 + 상태 판정  (Python: run_dummy.process 의 조립 부분, call_schema.json v1.0)&#xA;' In : maskedJson(String) Step4 결과 {&quot;transcript&quot;,&quot;pii&quot;}, analysisJson(String) Step3 결과 {&quot;result&quot;,&quot;error&quot;,&quot;retry_count&quot;},&#xA;'      sttStage(String) 앞 단계 실패 위치(&quot;INPUT&quot;/&quot;STT&quot;), sttError(String) 그 실패 사유(없으면 &quot;&quot;), fileName(String), seq(Int32) 순번, nowIso(String) &quot;yyyy-MM-ddTHH:mm:ss+09:00&quot;,&#xA;'      promptVersion, sttEngine, genaiModel(String)&#xA;' Out: docJson(String) 최종 JSON, assembleError(String; 성공이면 &quot;&quot;)&#xA;' 상태 판정: 유형 확신도 0.6 미만 또는 화자 구분 불확실(speaker_confidence=LOW)이면 NEEDS_REVIEW, 분석 실패/STT 실패면 FAILED, 그 외 SUCCESS&#xA;docJson = &quot;&quot;&#xA;assembleError = &quot;&quot;&#xA;Try&#xA;    Dim typeLabels As New System.Collections.Generic.Dictionary(Of String, String)&#xA;    typeLabels(&quot;INQUIRY&quot;) = &quot;질의&quot;&#xA;    typeLabels(&quot;COMPLAINT&quot;) = &quot;불만&quot;&#xA;    typeLabels(&quot;SUGGESTION&quot;) = &quot;건의&quot;&#xA;    typeLabels(&quot;TRAINING&quot;) = &quot;교육 내용&quot;&#xA;    typeLabels(&quot;OTHER&quot;) = &quot;기타 문의&quot;&#xA;&#xA;    Dim nowDt As System.DateTime = System.DateTime.ParseExact(nowIso.Substring(0, 19), &quot;yyyy-MM-dd'T'HH:mm:ss&quot;, System.Globalization.CultureInfo.InvariantCulture)&#xA;    Dim callId As String = nowDt.ToString(&quot;yyyyMMdd_HHmmss&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot;_&quot; &amp; seq.ToString(&quot;000&quot;, System.Globalization.CultureInfo.InvariantCulture)&#xA;&#xA;    Dim nullTok As Newtonsoft.Json.Linq.JToken = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    Dim doc As New Newtonsoft.Json.Linq.JObject()&#xA;    Dim src As New Newtonsoft.Json.Linq.JObject()&#xA;    src(&quot;file_name&quot;) = fileName&#xA;    src(&quot;file_path&quot;) = fileName&#xA;    src(&quot;duration_sec&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    src(&quot;received_at&quot;) = nowIso&#xA;    Dim proc As New Newtonsoft.Json.Linq.JObject()&#xA;    proc(&quot;stt_engine&quot;) = sttEngine&#xA;    proc(&quot;genai_model&quot;) = genaiModel&#xA;    proc(&quot;prompt_version&quot;) = promptVersion&#xA;    proc(&quot;retry_count&quot;) = 0&#xA;    proc(&quot;processed_at&quot;) = nowIso&#xA;&#xA;    doc(&quot;schema_version&quot;) = &quot;1.0&quot;&#xA;    doc(&quot;call_id&quot;) = callId&#xA;    doc(&quot;source&quot;) = src&#xA;    doc(&quot;call_datetime&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    doc(&quot;agent_name&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;    doc(&quot;customer_company&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;&#xA;    ' 실패 건에 채우는 빈 분석 필드&#xA;    Dim fillEmpty As System.Action = Sub()&#xA;                                         doc(&quot;type&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;type_label&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;type_confidence&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;customer_question&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;agent_action&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;summary&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;follow_up_required&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;follow_up&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                         doc(&quot;keywords&quot;) = New Newtonsoft.Json.Linq.JArray()&#xA;                                         doc(&quot;entities&quot;) = New Newtonsoft.Json.Linq.JArray()&#xA;                                     End Sub&#xA;&#xA;    If sttError &lt;&gt; &quot;&quot; Then&#xA;        ' STT 단계 실패: 전사·마스킹 없이 실패 건으로&#xA;        Dim errObj As New Newtonsoft.Json.Linq.JObject()&#xA;        errObj(&quot;stage&quot;) = If(sttStage = &quot;&quot;, &quot;STT&quot;, sttStage)&#xA;        errObj(&quot;reason&quot;) = sttError&#xA;        doc(&quot;status&quot;) = &quot;FAILED&quot;&#xA;        doc(&quot;error&quot;) = errObj&#xA;        fillEmpty()&#xA;        Dim emptyTr As New Newtonsoft.Json.Linq.JObject()&#xA;        emptyTr(&quot;full_text&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;        emptyTr(&quot;segments&quot;) = New Newtonsoft.Json.Linq.JArray()&#xA;        emptyTr(&quot;speaker_confidence&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;        Dim emptyPii As New Newtonsoft.Json.Linq.JObject()&#xA;        emptyPii(&quot;masked&quot;) = False&#xA;        emptyPii(&quot;counts&quot;) = New Newtonsoft.Json.Linq.JObject()&#xA;        doc(&quot;transcript&quot;) = emptyTr&#xA;        doc(&quot;pii&quot;) = emptyPii&#xA;    Else&#xA;        Dim rdM As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(maskedJson))&#xA;        rdM.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;        Dim maskedObj As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Load(rdM)&#xA;        Dim rdA As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(analysisJson))&#xA;        rdA.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;        Dim analysisObj As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Load(rdA)&#xA;&#xA;        Dim trTok As Newtonsoft.Json.Linq.JObject = CType(maskedObj(&quot;transcript&quot;), Newtonsoft.Json.Linq.JObject)&#xA;        Dim segArr As Newtonsoft.Json.Linq.JArray = CType(trTok(&quot;segments&quot;), Newtonsoft.Json.Linq.JArray)&#xA;        src(&quot;duration_sec&quot;) = segArr(segArr.Count - 1)(&quot;end_sec&quot;).DeepClone()&#xA;        proc(&quot;retry_count&quot;) = analysisObj(&quot;retry_count&quot;).DeepClone()&#xA;&#xA;        Dim speakerLow As Boolean = False&#xA;        Dim spTok As Newtonsoft.Json.Linq.JToken = trTok(&quot;speaker_confidence&quot;)&#xA;        If spTok IsNot Nothing AndAlso spTok.Type = Newtonsoft.Json.Linq.JTokenType.String Then speakerLow = (spTok.ToObject(Of String)() = &quot;LOW&quot;)&#xA;&#xA;        If analysisObj(&quot;error&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xA;            ' 분석(검증·재시도) 실패&#xA;            doc(&quot;status&quot;) = &quot;FAILED&quot;&#xA;            doc(&quot;error&quot;) = analysisObj(&quot;error&quot;).DeepClone()&#xA;            fillEmpty()&#xA;        Else&#xA;            Dim res As Newtonsoft.Json.Linq.JObject = CType(analysisObj(&quot;result&quot;), Newtonsoft.Json.Linq.JObject)&#xA;            Dim lowConf As Boolean = (res(&quot;type_confidence&quot;).ToObject(Of Double)() &lt; 0.6)&#xA;            doc(&quot;status&quot;) = If(lowConf OrElse speakerLow, &quot;NEEDS_REVIEW&quot;, &quot;SUCCESS&quot;)&#xA;            doc(&quot;error&quot;) = Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;            For Each prop As Newtonsoft.Json.Linq.JProperty In res.Properties()&#xA;                doc(prop.Name) = prop.Value.DeepClone()&#xA;            Next&#xA;            doc(&quot;type_label&quot;) = typeLabels(res(&quot;type&quot;).ToObject(Of String)())&#xA;        End If&#xA;        doc(&quot;transcript&quot;) = trTok.DeepClone()&#xA;        doc(&quot;pii&quot;) = maskedObj(&quot;pii&quot;).DeepClone()&#xA;    End If&#xA;    doc(&quot;processing&quot;) = proc&#xA;    docJson = doc.ToString(Newtonsoft.Json.Formatting.None)&#xA;Catch ex As System.Exception&#xA;    assembleError = &quot;결과 조립 실패(&quot; &amp; ex.GetType().Name &amp; &quot;): &quot; &amp; ex.Message&#xA;    docJson = &quot;&quot;&#xA;End Try"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="maskedJson">[maskedJson]</InArgument><InArgument x:TypeArguments="x:String" x:Key="analysisJson">[finalJson]</InArgument><InArgument x:TypeArguments="x:String" x:Key="sttStage">[sttStage]</InArgument><InArgument x:TypeArguments="x:String" x:Key="sttError">[sttError]</InArgument><InArgument x:TypeArguments="x:String" x:Key="fileName">[fileName]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="seq">[seq]</InArgument><InArgument x:TypeArguments="x:String" x:Key="nowIso">[nowIso]</InArgument><InArgument x:TypeArguments="x:String" x:Key="promptVersion">[promptVersion]</InArgument><InArgument x:TypeArguments="x:String" x:Key="sttEngine">[sttEngine]</InArgument><InArgument x:TypeArguments="x:String" x:Key="genaiModel">[genaiModel]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="docJson">[docJson]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="assembleError">[assembleError]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[assembleError &lt;&gt; &quot;&quot;]" DisplayName="조립 실패?"><If.Then><Throw DisplayName="결과 조립 실패" Exception="[New System.InvalidOperationException(assembleError &amp; &quot; (파일: &quot; &amp; fileName &amp; &quot;)&quot;)]" /></If.Then></If><ui:InvokeCode DisplayName="결과에서 상태·오류·재시도 횟수 읽기 (Invoke Code)" Language="VBNet" Code="' Step8: 최종 JSON 에서 로그·분기에 쓸 값을 꺼낸다 (결과 문서의 status / error / processing.retry_count)&#xA;' In : docJson(String) Step5 가 만든 최종 JSON&#xA;' Out: docStatus(String) SUCCESS/NEEDS_REVIEW/FAILED (읽지 못하면 &quot;UNKNOWN&quot;), errStage(String), errReason(String) (오류가 없으면 &quot;&quot;), retryCount(Int32)&#xA;docStatus = &quot;&quot;&#xA;errStage = &quot;&quot;&#xA;errReason = &quot;&quot;&#xA;retryCount = 0&#xA;Try&#xA;    Dim rdDoc As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(docJson))&#xA;    rdDoc.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;    Dim docObj As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Load(rdDoc)&#xA;    docStatus = docObj.Value(Of String)(&quot;status&quot;)&#xA;    Dim errTok As Newtonsoft.Json.Linq.JToken = docObj(&quot;error&quot;)&#xA;    If errTok IsNot Nothing AndAlso errTok.Type = Newtonsoft.Json.Linq.JTokenType.Object Then&#xA;        errStage = CType(errTok, Newtonsoft.Json.Linq.JObject).Value(Of String)(&quot;stage&quot;)&#xA;        errReason = CType(errTok, Newtonsoft.Json.Linq.JObject).Value(Of String)(&quot;reason&quot;)&#xA;    End If&#xA;    retryCount = CType(docObj(&quot;processing&quot;), Newtonsoft.Json.Linq.JObject).Value(Of Integer)(&quot;retry_count&quot;)&#xA;Catch ex As System.Exception&#xA;    docStatus = &quot;UNKNOWN&quot;&#xA;End Try"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="docJson">[docJson]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="docStatus">[docStatus]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="errStage">[errStage]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="errReason">[errReason]</OutArgument><OutArgument x:TypeArguments="x:Int32" x:Key="retryCount">[retryCount]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><Assign x:TypeArguments="x:String" DisplayName="call_id" To="[callId]" Value="[nowIso.Substring(0, 4) &amp; nowIso.Substring(5, 2) &amp; nowIso.Substring(8, 2) &amp; &quot;_&quot; &amp; nowIso.Substring(11, 2) &amp; nowIso.Substring(14, 2) &amp; nowIso.Substring(17, 2) &amp; &quot;_&quot; &amp; seq.ToString(&quot;000&quot;)]" /><ui:InvokeCode DisplayName="결과 파일 이름 정하기 (Invoke Code)" Language="VBNet" Code="' Step8: 대상 폴더에서 겹치지 않는 파일 경로 정하기  (Python: run_folder.unique_dest)&#xA;' In : destDir(String) 대상 폴더, fileName(String) 원하는 파일 이름&#xA;' Out: destPath(String) destDir 에 같은 이름이 없으면 그대로, 있으면 stem_1.ext, stem_2.ext ... (같은 이름의 폴더도 충돌로 본다)&#xA;Dim pickStem As String = System.IO.Path.GetFileNameWithoutExtension(fileName)&#xA;Dim pickExt As String = System.IO.Path.GetExtension(fileName)&#xA;destPath = System.IO.Path.Combine(destDir, fileName)&#xA;If System.IO.File.Exists(destPath) OrElse System.IO.Directory.Exists(destPath) Then&#xA;    Dim pickN As Integer = 1&#xA;    Do While System.IO.File.Exists(System.IO.Path.Combine(destDir, pickStem &amp; &quot;_&quot; &amp; pickN.ToString() &amp; pickExt)) OrElse System.IO.Directory.Exists(System.IO.Path.Combine(destDir, pickStem &amp; &quot;_&quot; &amp; pickN.ToString() &amp; pickExt))&#xA;        pickN = pickN + 1&#xA;    Loop&#xA;    destPath = System.IO.Path.Combine(destDir, pickStem &amp; &quot;_&quot; &amp; pickN.ToString() &amp; pickExt)&#xA;End If"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="destDir">[outDir]</InArgument><InArgument x:TypeArguments="x:String" x:Key="fileName">[callId &amp; &quot;.json&quot;]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="destPath">[outPath]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="결과 JSON 저장 (out)" Encoding="utf-8" FileName="[outPath]" Text="[docJson]" /><Assign x:TypeArguments="x:Boolean" DisplayName="실패 건인지 (결과의 status 기준)" To="[isFailed]" Value="[docStatus = &quot;FAILED&quot;]" /><ui:InvokeCode DisplayName="원본 음성 이동 (Invoke Code)" Language="VBNet" Code="' Step8: 파일 이동 (이름이 겹치면 번호를 붙임)  (Python: run_folder.move_unique)&#xA;' In : srcPath(String) 옮길 파일, destDir(String) 대상 폴더(없으면 만든다)&#xA;' Out: movedPath(String) 이동 후 경로 (실패하면 &quot;&quot;), moveError(String; 성공이면 &quot;&quot;) — 실패해도 예외를 던지지 않고 파일은 제자리에 둔다&#xA;movedPath = &quot;&quot;&#xA;moveError = &quot;&quot;&#xA;Try&#xA;    System.IO.Directory.CreateDirectory(destDir)&#xA;    Dim mvName As String = System.IO.Path.GetFileName(srcPath)&#xA;    Dim mvStem As String = System.IO.Path.GetFileNameWithoutExtension(mvName)&#xA;    Dim mvExt As String = System.IO.Path.GetExtension(mvName)&#xA;    Dim mvDest As String = System.IO.Path.Combine(destDir, mvName)&#xA;    If System.IO.File.Exists(mvDest) OrElse System.IO.Directory.Exists(mvDest) Then&#xA;        Dim mvN As Integer = 1&#xA;        Do While System.IO.File.Exists(System.IO.Path.Combine(destDir, mvStem &amp; &quot;_&quot; &amp; mvN.ToString() &amp; mvExt)) OrElse System.IO.Directory.Exists(System.IO.Path.Combine(destDir, mvStem &amp; &quot;_&quot; &amp; mvN.ToString() &amp; mvExt))&#xA;            mvN = mvN + 1&#xA;        Loop&#xA;        mvDest = System.IO.Path.Combine(destDir, mvStem &amp; &quot;_&quot; &amp; mvN.ToString() &amp; mvExt)&#xA;    End If&#xA;    If Not System.IO.File.Exists(srcPath) Then Throw New System.IO.FileNotFoundException()&#xA;    System.IO.File.Move(srcPath, mvDest)&#xA;    movedPath = mvDest&#xA;Catch ex As System.Exception&#xA;    ' Python 의 예외 이름과 맞춘다 (FileNotFoundError / PermissionError / OSError)&#xA;    Dim mvLabel As String = &quot;OSError&quot;&#xA;    If TypeOf ex Is System.IO.FileNotFoundException OrElse TypeOf ex Is System.IO.DirectoryNotFoundException Then&#xA;        mvLabel = &quot;FileNotFoundError&quot;&#xA;    ElseIf TypeOf ex Is System.UnauthorizedAccessException Then&#xA;        mvLabel = &quot;PermissionError&quot;&#xA;    End If&#xA;    movedPath = &quot;&quot;&#xA;    moveError = &quot;이동 실패(&quot; &amp; mvLabel &amp; &quot;)&quot;&#xA;End Try"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="srcPath">[filePath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="destDir">[If(isFailed, failedDir, doneDir)]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="movedPath">[movedPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="moveError">[moveError]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[moveError &lt;&gt; &quot;&quot;]" DisplayName="이동 실패?"><If.Then><ui:LogMessage DisplayName="이동 실패 경고" Level="Warn" Message="[fileName &amp; &quot; &quot; &amp; moveError &amp; &quot; — 원본을 제자리에 둠&quot;]" /></If.Then></If><If Condition="[isFailed]" DisplayName="실패 건 집계"><If.Then><Assign x:TypeArguments="x:Int32" DisplayName="실패 건수" To="[failedCount]" Value="[failedCount + 1]" /></If.Then><If.Else><Assign x:TypeArguments="x:Int32" DisplayName="완료 건수" To="[doneCount]" Value="[doneCount + 1]" /></If.Else></If><ui:LogMessage DisplayName="파일 로그" Level="Info" Message="[fileName &amp; &quot; → &quot; &amp; If(isFailed, &quot;failed&quot;, &quot;done&quot;) &amp; &quot; [&quot; &amp; docStatus &amp; &quot;]&quot; &amp; If(errStage &lt;&gt; &quot;&quot;, &quot; &quot; &amp; errStage &amp; &quot;: &quot; &amp; errReason, &quot;&quot;) &amp; &quot; (재시도 &quot; &amp; retryCount.ToString() &amp; &quot;회, 결과 &quot; &amp; System.IO.Path.GetFileName(outPath) &amp; &quot;)&quot;]" /></Sequence></ActivityAction></ui:ForEach.Body></ui:ForEach><ui:LogMessage DisplayName="요약 로그" Level="Info" Message="[&quot;처리 끝 — 완료(done) &quot; &amp; doneCount.ToString() &amp; &quot;건, 실패(failed) &quot; &amp; failedCount.ToString() &amp; &quot;건&quot;]" /></Sequence>
