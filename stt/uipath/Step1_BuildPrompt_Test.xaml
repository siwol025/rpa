ompt = &quot;&quot;&#xA;userPrompt = &quot;&quot;&#xA;Dim keptLines As New System.Collections.Generic.List(Of String)&#xA;For Each rawLine As String In System.Text.RegularExpressions.Regex.Split(If(promptText, &quot;&quot;), &quot;\r\n|\n|\r&quot;)&#xA;    ' 설명용 '#' 줄 제외 (Python: not l.lstrip().startswith(&quot;#&quot;))&#xA;    If Not rawLine.TrimStart().StartsWith(&quot;#&quot;, System.StringComparison.Ordinal) Then keptLines.Add(rawLine)&#xA;Next&#xA;Dim promptBody As String = String.Join(vbLf, keptLines)&#xA;Dim blockMatch As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(promptBody, &quot;\[SYSTEM\](.*?)\[USER TEMPLATE\](.*)&quot;, System.Text.RegularExpressions.RegexOptions.Singleline)&#xA;If Not blockMatch.Success Then&#xA;    buildError = &quot;prompt 파일에 [SYSTEM]/[USER TEMPLATE] 블록이 없음&quot;&#xA;Else&#xA;    systemPrompt = blockMatch.Groups(1).Value.Trim()&#xA;    userPrompt = blockMatch.Groups(2).Value.Trim().Replace(&quot;{{TRANSCRIPT}}&quot;, If(transcriptText, &quot;&quot;))&#xA;End If"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="promptText">[promptText]</InArgument><InArgument x:TypeArguments="x:String" x:Key="transcriptText">[transcriptText]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="systemPrompt">[systemPrompt]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="userPrompt">[userPrompt]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="buildError">[buildError]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:CreateDirectory DisplayName="결과 폴더 만들기" Output="{x:Null}" Path="[System.IO.Path.Combine(outDir, &quot;step1&quot;, caseName)]" /><ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="system.txt 저장" Encoding="utf-8" FileName="[System.IO.Path.Combine(outDir, &quot;step1&quot;, caseName, &quot;system.txt&quot;)]" Text="[systemPrompt]" /><ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="user.txt 저장" Encoding="utf-8" FileName="[System.IO.Path.Combine(outDir, &quot;step1&quot;, caseName, &quot;user.txt&quot;)]" Text="[userPrompt]" /><ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="error.txt 저장" Encoding="utf-8" FileName="[System.IO.Path.Combine(outDir, &quot;step1&quot;, caseName, &quot;error.txt&quot;)]" Text="[buildError]" /><ui:LogMessage DisplayName="로그" Level="Info" Message="[caseName &amp; &quot; 프롬프트 조립 완료 (system &quot; &amp; systemPrompt.Length.ToString() &amp; &quot;자, user &quot; &amp; userPrompt.Length.ToString() &amp; &quot;자, 오류: &quot; &amp; buildError &amp; &quot;)&quot;]" /></Sequence></ActivityAction></ui:ForEach.Body></ui:ForEach></Sequence>
