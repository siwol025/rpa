  <Sequence DisplayName="서버 등록 (R-04)" sap2010:Annotation.AnnotationText="녹취 파일을 서버에 먼저 등록한다. (STT보다 먼저 해야 중간에 실패해도 서버에 기록이 남는다)"><ui:InvokeCode DisplayName="음성 파일 업로드 (Invoke Code)" Language="VBNet" Code="&apos; R-04 등록: 음성 파일 + 메타데이터를 multipart로 보낸다. API 키는 로그·오류에 넣지 않는다.&#xA;httpStatus = 0&#xA;callId = 0&#xA;errCode = &quot;&quot;&#xA;existingId = 0&#xA;existingStatus = &quot;&quot;&#xA;respBody = &quot;&quot;&#xA;netError = &quot;&quot;&#xA;fileHash = &quot;&quot;&#xA;Try&#xA;    Dim bytes As Byte() = System.IO.File.ReadAllBytes(audioPath)&#xA;    Using sha As System.Security.Cryptography.SHA256 = System.Security.Cryptography.SHA256.Create()&#xA;        fileHash = BitConverter.ToString(sha.ComputeHash(bytes)).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant()&#xA;    End Using&#xA;    Dim ext As String = System.IO.Path.GetExtension(audioPath).ToLowerInvariant()&#xA;    Using client As New System.Net.Http.HttpClient()&#xA;        client.Timeout = TimeSpan.FromMinutes(5)&#xA;        client.DefaultRequestHeaders.Add(&quot;X-API-Key&quot;, apiKey)&#xA;        Using form As New System.Net.Http.MultipartFormDataContent()&#xA;            Dim fileContent As New System.Net.Http.ByteArrayContent(bytes)&#xA;            fileContent.Headers.ContentType = New System.Net.Http.Headers.MediaTypeHeaderValue(If(ext = &quot;.mp3&quot;, &quot;audio/mpeg&quot;, &quot;audio/wav&quot;))&#xA;            form.Add(fileContent, &quot;file&quot;, System.IO.Path.GetFileName(audioPath))&#xA;            form.Add(New System.Net.Http.StringContent(fileHash), &quot;file_hash&quot;)&#xA;            form.Add(New System.Net.Http.StringContent(originalName, System.Text.Encoding.UTF8), &quot;original_name&quot;)&#xA;            form.Add(New System.Net.Http.StringContent(sourceType), &quot;source_type&quot;)&#xA;            If Not String.IsNullOrWhiteSpace(sourceRef) Then form.Add(New System.Net.Http.StringContent(sourceRef, System.Text.Encoding.UTF8), &quot;source_ref&quot;)&#xA;            If Not String.IsNullOrWhiteSpace(callDatetime) Then form.Add(New System.Net.Http.StringContent(callDatetime), &quot;call_datetime&quot;)&#xA;            If Not String.IsNullOrWhiteSpace(agentName) Then form.Add(New System.Net.Http.StringContent(agentName, System.Text.Encoding.UTF8), &quot;agent_name&quot;)&#xA;            If Not String.IsNullOrWhiteSpace(clientCompany) Then form.Add(New System.Net.Http.StringContent(clientCompany, System.Text.Encoding.UTF8), &quot;client_company&quot;)&#xA;            Using resp As System.Net.Http.HttpResponseMessage = client.PostAsync(baseUrl.TrimEnd(&quot;/&quot;c) &amp; &quot;/api/robot/calls&quot;, form).GetAwaiter().GetResult()&#xA;                httpStatus = CInt(resp.StatusCode)&#xA;                respBody = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;            End Using&#xA;        End Using&#xA;    End Using&#xA;    If Not String.IsNullOrWhiteSpace(respBody) Then&#xA;        Try&#xA;            Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(respBody)&#xA;            Dim t As Newtonsoft.Json.Linq.JToken = jo.SelectToken(&quot;call_id&quot;)&#xA;            If t IsNot Nothing Then callId = Integer.Parse(t.ToString())&#xA;            t = jo.SelectToken(&quot;code&quot;)&#xA;            If t IsNot Nothing Then errCode = t.ToString()&#xA;            t = jo.SelectToken(&quot;detail.existing_id&quot;)&#xA;            If t IsNot Nothing Then existingId = Integer.Parse(t.ToString())&#xA;            t = jo.SelectToken(&quot;detail.status&quot;)&#xA;            If t IsNot Nothing Then existingStatus = t.ToString()&#xA;        Catch&#xA;        End Try&#xA;    End If&#xA;Catch ex As System.Exception&#xA;    netError = ex.GetType().Name &amp; &quot;: &quot; &amp; ex.Message&#xA;End Try" sap2010:Annotation.AnnotationText="파일의 SHA-256을 계산해 음성 파일과 함께 POST /api/robot/calls 로 보낸다. 201이면 call_id, 409(중복)이면 기존 건의 id와 상태를 돌려준다."><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="baseUrl">[baseUrl]</InArgument><InArgument x:TypeArguments="x:String" x:Key="apiKey">[apiKey]</InArgument><InArgument x:TypeArguments="x:String" x:Key="audioPath">[audioPath]</InArgument><InArgument x:TypeArguments="x:String" x:Key="originalName">[originalName]</InArgument><InArgument x:TypeArguments="x:String" x:Key="sourceType">[sourceType]</InArgument><InArgument x:TypeArguments="x:String" x:Key="sourceRef">[sourceRef]</InArgument><InArgument x:TypeArguments="x:String" x:Key="callDatetime">[callDatetime]</InArgument><InArgument x:TypeArguments="x:String" x:Key="agentName">[agentName]</InArgument><InArgument x:TypeArguments="x:String" x:Key="clientCompany">[clientCompany]</InArgument><OutArgument x:TypeArguments="x:Int32" x:Key="httpStatus">[httpStatus]</OutArgument><OutArgument x:TypeArguments="x:Int32" x:Key="callId">[callId]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="errCode">[errCode]</OutArgument><OutArgument x:TypeArguments="x:Int32" x:Key="existingId">[existingId]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="existingStatus">[existingStatus]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="respBody">[respBody]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="netError">[netError]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="fileHash">[fileHash]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="등록 결과 로그" Level="Info" Message="[&quot;[API] 등록 &quot; &amp; originalName &amp; &quot; → &quot; &amp; If(netError &lt;&gt; &quot;&quot;, &quot;연결 실패(&quot; &amp; netError &amp; &quot;)&quot;, &quot;HTTP &quot; &amp; httpStatus.ToString &amp; If(callId &gt; 0, &quot; call_id=&quot; &amp; callId.ToString, &quot;&quot;) &amp; If(errCode &lt;&gt; &quot;&quot;, &quot; &quot; &amp; errCode &amp; &quot; (기존 id=&quot; &amp; existingId.ToString &amp; &quot;, 상태=&quot; &amp; existingStatus &amp; &quot;)&quot;, &quot;&quot;))]" /></Sequence>
