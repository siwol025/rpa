  <Sequence DisplayName="음성 내려받기 (R-10)" sap2010:Annotation.AnnotationText="재처리할 때 서버 사본 음성을 내려받는다."><ui:InvokeCode DisplayName="음성 파일 다운로드 (Invoke Code)" Language="VBNet" Code="&apos; R-10 음성 다운로드: 서버에 보관된 음성 사본을 파일로 저장한다. API 키는 로그·오류에 넣지 않는다.&#xA;httpStatus = 0&#xA;savedPath = &quot;&quot;&#xA;netError = &quot;&quot;&#xA;Try&#xA;    System.IO.Directory.CreateDirectory(destFolder)&#xA;    Using client As New System.Net.Http.HttpClient()&#xA;        client.Timeout = TimeSpan.FromMinutes(5)&#xA;        client.DefaultRequestHeaders.Add(&quot;X-API-Key&quot;, apiKey)&#xA;        Using resp As System.Net.Http.HttpResponseMessage = client.GetAsync(baseUrl.TrimEnd(&quot;/&quot;c) &amp; &quot;/api/robot/calls/&quot; &amp; callId.ToString() &amp; &quot;/audio&quot;).GetAwaiter().GetResult()&#xA;            httpStatus = CInt(resp.StatusCode)&#xA;            If httpStatus = 200 Then&#xA;                Dim mt As String = &quot;&quot;&#xA;                If resp.Content.Headers.ContentType IsNot Nothing Then mt = resp.Content.Headers.ContentType.MediaType&#xA;                Dim ext As String = If(mt = &quot;audio/mpeg&quot;, &quot;.mp3&quot;, &quot;.wav&quot;)&#xA;                savedPath = System.IO.Path.Combine(destFolder, callId.ToString() &amp; &quot;_retry&quot; &amp; retryNo.ToString() &amp; ext)&#xA;                System.IO.File.WriteAllBytes(savedPath, resp.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult())&#xA;            End If&#xA;        End Using&#xA;    End Using&#xA;Catch ex As System.Exception&#xA;    netError = ex.GetType().Name &amp; &quot;: &quot; &amp; ex.Message&#xA;End Try" sap2010:Annotation.AnnotationText="서버에 보관된 음성 사본을 받아 폴더에 저장한다. 원본 폴더에서 파일이 옮겨졌어도 재처리할 수 있다."><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="baseUrl">[baseUrl]</InArgument><InArgument x:TypeArguments="x:String" x:Key="apiKey">[apiKey]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="callId">[callId]</InArgument><InArgument x:TypeArguments="x:Int32" x:Key="retryNo">[retryNo]</InArgument><InArgument x:TypeArguments="x:String" x:Key="destFolder">[destFolder]</InArgument><OutArgument x:TypeArguments="x:Int32" x:Key="httpStatus">[httpStatus]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="savedPath">[savedPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="netError">[netError]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="다운로드 로그" Level="Info" Message="[&quot;[API] 음성 다운로드 call_id=&quot; &amp; callId.ToString &amp; &quot; → &quot; &amp; If(netError &lt;&gt; &quot;&quot;, &quot;연결 실패(&quot; &amp; netError &amp; &quot;)&quot;, &quot;HTTP &quot; &amp; httpStatus.ToString &amp; If(savedPath &lt;&gt; &quot;&quot;, &quot; 저장: &quot; &amp; Path.GetFileName(savedPath), &quot;&quot;))]" /></Sequence>
