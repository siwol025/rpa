" Name="exception" /></ActivityAction.Argument><ui:LogMessage DisplayName="③ 처리 오류 로그" Level="Error" Message="[&quot;[Main_Audio] ③ 처리 실패(Performer는 계속): &quot; &amp; exception.Message]" /></ActivityAction></Catch></TryCatch.Catches></TryCatch><ui:InvokeWorkflowFile DisplayName="4. 큐 처리 (Performer)" UnSafe="False" WorkflowFileName="Flow_PerformerAudio.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile><TryCatch DisplayName="5. 엑셀 보고서 최신순 정렬" sap2010:Annotation.AnnotationText="통화이력·예외 표를 통화일시·수신시각 내림차순으로 정렬해 새 건이 표 맨 위에 보이게 한다. 실패해도 처리 결과에는 영향 없음."><TryCatch.Try><ui:InvokeCode DisplayName="표 정렬 (Invoke Code)" Language="VBNet" Code="' 엑셀 보고서의 통화이력·예외 표를 최신순(통화일시·수신시각 내림차순)으로 정렬해, 방금 처리한 건이 표 맨 위에 보이게 한다.&#xA;' Invoke Code는 Option Strict On이라 COM은 CallByName으로 호출한다.&#xA;Dim path As String = System.IO.Path.Combine(baseDir, &quot;Runtime&quot;, &quot;report&quot;, &quot;콜센터_보고서.xlsx&quot;)&#xA;If Not System.IO.File.Exists(path) Then Return&#xA;Dim C As Func(Of Object, String, Microsoft.VisualBasic.CallType, Object(), Object) = Function(o, n, ct, a)&#xA;        ' Excel이 막 떠서 바쁘면 RPC_E_CALL_REJECTED(0x80010001)·RPC_E_SERVERCALL_RETRYLATER(0x8001010A)가 나므로 잠시 후 다시 부른다.&#xA;        For i As Integer = 1 To 40&#xA;            Try&#xA;                Return Microsoft.VisualBasic.Interaction.CallByName(o, n, ct, a)&#xA;            Catch ex As Exception&#xA;                Dim hr As Integer = If(ex.InnerException IsNot Nothing, ex.InnerException.HResult, ex.HResult)&#xA;                If hr &lt;&gt; &amp;H80010001 AndAlso hr &lt;&gt; &amp;H8001010A Then Throw&#xA;                System.Threading.Thread.Sleep(250)&#xA;            End Try&#xA;        Next&#xA;        Return Microsoft.VisualBasic.Interaction.CallByName(o, n, ct, a)&#xA;    End Function&#xA;Dim G As Func(Of Object, String, Object(), Object) = Function(o, n, a) C(o, n, Microsoft.VisualBasic.CallType.Get, a)&#xA;Dim M As Func(Of Object, String, Object(), Object) = Function(o, n, a) C(o, n, Microsoft.VisualBasic.CallType.Method, a)&#xA;Dim L As Action(Of Object, String, Object) = Sub(o, n, v) C(o, n, Microsoft.VisualBasic.CallType.Let, New Object() {v})&#xA;Dim xl As Object = Activator.CreateInstance(Type.GetTypeFromProgID(&quot;Excel.Application&quot;))&#xA;Try&#xA;    L(xl, &quot;Visible&quot;, False)&#xA;    L(xl, &quot;DisplayAlerts&quot;, False)&#xA;    Dim wb As Object = M(G(xl, &quot;Workbooks&quot;, New Object() {}), &quot;Open&quot;, New Object() {path})&#xA;    Try&#xA;        Dim targets As String()() = {New String() {&quot;통화이력&quot;, &quot;tblCalls&quot;, &quot;통화일시&quot;}, New String() {&quot;예외&quot;, &quot;tblErrors&quot;, &quot;수신시각&quot;}}&#xA;        For Each t As String() In targets&#xA;            Dim ws As Object = G(G(wb, &quot;Worksheets&quot;, New Object() {}), &quot;Item&quot;, New Object() {t(0)})&#xA;            Dim lo As Object = G(G(ws, &quot;ListObjects&quot;, New Object() {}), &quot;Item&quot;, New Object() {t(1)})&#xA;            Dim cnt As Integer = CInt(G(G(lo, &quot;ListRows&quot;, New Object() {}), &quot;Count&quot;, New Object() {}))&#xA;            If cnt &gt; 1 Then&#xA;                Dim srt As Object = G(lo, &quot;Sort&quot;, New Object() {})&#xA;                Dim fields As Object = G(srt, &quot;SortFields&quot;, New Object() {})&#xA;                M(fields, &quot;Clear&quot;, New Object() {})&#xA;                Dim key As Object = G(G(G(lo, &quot;ListColumns&quot;, New Object() {}), &quot;Item&quot;, New Object() {t(2)}), &quot;Range&quot;, New Object() {})&#xA;                M(fields, &quot;Add&quot;, New Object() {key, 0, 2})&#xA;                L(srt, &quot;Header&quot;, 1)&#xA;                M(srt, &quot;Apply&quot;, New Object() {})&#xA;            End If&#xA;        Next&#xA;        M(wb, &quot;Save&quot;, New Object() {})&#xA;    Finally&#xA;        M(wb, &quot;Close&quot;, New Object() {False})&#xA;    End Try&#xA;Finally&#xA;    M(xl, &quot;Quit&quot;, New Object() {})&#xA;    System.Runtime.InteropServices.Marshal.ReleaseComObject(xl)&#xA;End Try"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="baseDir">[baseDir]</InArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="s:Exception"><ActivityAction x:TypeArguments="s:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument><ui:LogMessage DisplayName="정렬 실패 경고" Level="Warn" Message="[&quot;[Main_Audio] 엑셀 정렬 실패(처리 결과는 정상): &quot; &amp; exception.Message]" /></ActivityAction></Catch></TryCatch.Catches></TryCatch><ui:LogMessage DisplayName="종료 로그" Level="Info" Message="[&quot;[Main_Audio] 끝. 재처리 등록 &quot; &amp; n.ToString &amp; &quot;건&quot;]" /></Sequence>
