  <Sequence DisplayName="설정 읽기" sap2010:Annotation.AnnotationText="큐 이름과 폴더 위치, 정체 판단 시간을 설정 파일에서 읽는다."><ui:InvokeCode DisplayName="설정 파일 읽기 (Invoke Code)" Language="VBNet" Code="&apos; Config\config.json 을 읽어 설정값을 돌려준다. 파일이 없거나 항목이 비면 기본값을 쓴다.&#xA;queueName = &quot;CallCenter_Calls&quot;&#xA;inboxFolder = &quot;Runtime\inbox&quot;&#xA;processingFolder = &quot;Runtime\processing&quot;&#xA;doneFolder = &quot;Runtime\done&quot;&#xA;failedFolder = &quot;Runtime\failed&quot;&#xA;outFolder = &quot;Runtime\out&quot;&#xA;processedFolder = &quot;Runtime\out\processed&quot;&#xA;errorFolder = &quot;Runtime\out\error&quot;&#xA;staleMinutes = 10&#xA;Dim cfgPath As String = System.IO.Path.Combine(baseDir, &quot;Config&quot;, &quot;config.json&quot;)&#xA;If System.IO.File.Exists(cfgPath) Then&#xA;    Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText(cfgPath, System.Text.Encoding.UTF8))&#xA;    Dim v As Newtonsoft.Json.Linq.JToken&#xA;    v = jo.SelectToken(&quot;queueName&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then queueName = v.ToString()&#xA;    v = jo.SelectToken(&quot;inboxFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then inboxFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;processingFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then processingFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;doneFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then doneFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;failedFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then failedFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;outFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then outFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;processedFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then processedFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;errorFolder&quot;) : If v IsNot Nothing AndAlso v.ToString() &lt;&gt; &quot;&quot; Then errorFolder = v.ToString()&#xA;    v = jo.SelectToken(&quot;staleMinutes&quot;) : If v IsNot Nothing Then Integer.TryParse(v.ToString(), staleMinutes)&#xA;End If&#xA;&apos; 상대 경로는 프로젝트 폴더 기준으로 바꾼다. 절대 경로(예: 구글 드라이브 폴더)는 그대로 쓴다.&#xA;If Not System.IO.Path.IsPathRooted(inboxFolder) Then inboxFolder = System.IO.Path.Combine(baseDir, inboxFolder)&#xA;If Not System.IO.Path.IsPathRooted(processingFolder) Then processingFolder = System.IO.Path.Combine(baseDir, processingFolder)&#xA;If Not System.IO.Path.IsPathRooted(doneFolder) Then doneFolder = System.IO.Path.Combine(baseDir, doneFolder)&#xA;If Not System.IO.Path.IsPathRooted(failedFolder) Then failedFolder = System.IO.Path.Combine(baseDir, failedFolder)&#xA;If Not System.IO.Path.IsPathRooted(outFolder) Then outFolder = System.IO.Path.Combine(baseDir, outFolder)&#xA;If Not System.IO.Path.IsPathRooted(processedFolder) Then processedFolder = System.IO.Path.Combine(baseDir, processedFolder)&#xA;If Not System.IO.Path.IsPathRooted(errorFolder) Then errorFolder = System.IO.Path.Combine(baseDir, errorFolder)&#xA;If staleMinutes &lt; 1 Then staleMinutes = 10" sap2010:Annotation.AnnotationText="Config\config.json 을 읽는다. 없거나 항목이 비어 있으면 기본값을 쓰므로 기존 동작과 같다."><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="baseDir">[baseDir]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="queueName">[queueName]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="inboxFolder">[inboxFolder]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="processingFolder">[processingFolder]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="doneFolder">[doneFolder]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="failedFolder">[failedFolder]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="outFolder">[outFolder]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="processedFolder">[processedFolder]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="errorFolder">[errorFolder]</OutArgument><OutArgument x:TypeArguments="x:Int32" x:Key="staleMinutes">[staleMinutes]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="설정 로그" Level="Info" Message="[&quot;[Config] 큐=&quot; &amp; queueName &amp; &quot;, inbox=&quot; &amp; inboxFolder &amp; &quot;, 정체 판단=&quot; &amp; staleMinutes.ToString &amp; &quot;분&quot;]" /></Sequence>
