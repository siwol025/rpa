peArguments="x:Int32" Name="rowIdx" /><Variable x:TypeArguments="x:Int32" Name="targetRow" /><Variable x:TypeArguments="x:String" Name="httpMethod" /><Variable x:TypeArguments="x:String" Name="apiPath" /><Variable x:TypeArguments="x:String" Name="bodyJson" /><Variable x:TypeArguments="x:Int32" Name="httpStatus" /><Variable x:TypeArguments="x:String" Name="respBody" /><Variable x:TypeArguments="x:String" Name="netError" /><Variable x:TypeArguments="x:Boolean" Name="proceed" /></Sequence.Variables><TryCatch DisplayName="거래 1건 처리 (업무 오류 / 시스템 오류 구분)"><TryCatch.Try><Sequence DisplayName="처리"><Assign DisplayName="단계 표시(초기값)"><Assign.To><OutArgument x:TypeArguments="x:String">[phase]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;RESULT&quot;]</InArgument></Assign.Value></Assign><Assign DisplayName="큐 항목에서 음성 경로 꺼내기" sap2010:Annotation.AnnotationText="Dispatcher가 큐 항목에 담아 둔 음성 파일 경로"><Assign.To><OutArgument x:TypeArguments="x:String">[audioPath]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[CStr(transactionItem.SpecificContent(&quot;FilePath&quot;))]</InArgument></Assign.Value></Assign><Assign DisplayName="큐 항목에서 서버 call_id 꺼내기"><Assign.To><OutArgument x:TypeArguments="x:Int32">[serverId]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[CInt(transactionItem.SpecificContent(&quot;CallId&quot;))]</InArgument></Assign.Value></Assign><ui:LogMessage DisplayName="거래 시작 로그" Level="Info" Message="[&quot;[Performer] 거래 시작: &quot; &amp; transactionItem.Reference &amp; &quot; (재시도 &quot; &amp; transactionItem.RetryNo.ToString &amp; &quot;회) &quot; &amp; Path.GetFileName(audioPath)]" /><ui:InvokeWorkflowFile DisplayName="분석 결과 JSON 찾기" UnSafe="False" WorkflowFileName="Flow_FindResult.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="outFolder">[outFolder]</InArgument><InArgument x:TypeArguments="x:String" x:Key="audioName">[Path.GetFileName(audioPath)]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="resultPath">[currentFile]</OutArgument></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile><If Condition="[String.IsNullOrEmpty(currentFile)]" DisplayName="결과 JSON이 있는가?" sap2010:Annotation.AnnotationText="③이 결과를 아직 안 만들었으면 시스템 오류로 기록해 큐의 자동 재시도에 맡긴다."><If.Then><Throw DisplayName="시스템 오류: 분석 결과 아직 없음" Exception="[(New Exception(&quot;분석 결과 JSON이 아직 없습니다(③ 처리 전): &quot; &amp; Path.GetFileName(audioPath)))]" /></If.Then></If><ui:ReadTextFile Content="[jsonText]" DisplayName="결과 JSON 읽기" Encoding="{x:Null}" File="{x:Null}" FileName="[currentFile]" /><Assign DisplayName="JSON 파싱"><Assign.To><OutArgument x:TypeArguments="nj:JObject">[jo]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="nj:JObject">[JObject.Parse(jsonText)]</InArgument></Assign.Value></Assign><ui:InvokeCode DisplayName="통화일시·담당자·고객사 보완 (Invoke Code)" Language="VBNet" Code="' ③ 결과에는 통화일시·담당자·고객사가 비어 있을 수 있다(③은 파일명을 해석하지 않음).&#xA;' 엑셀 기입용으로만 채운다: 서버 상세(등록 때 파일명에서 뽑은 값) → 실패하면 파일명 규칙 {yyyyMMdd_HHmmss}_{담당자}_{고객사}.&#xA;Dim needDt As Boolean = jo(&quot;call_datetime&quot;) Is Nothing OrElse jo(&quot;call_datetime&quot;).Type = Newtonsoft.Json.Linq.JTokenType.Null&#xA;Dim needAgent As Boolean = jo(&quot;agent_name&quot;) Is Nothing OrElse jo(&quot;agent_name&quot;).Type = Newtonsoft.Json.Linq.JTokenType.Null&#xA;Dim needCo As Boolean = jo(&quot;customer_company&quot;) Is Nothing OrElse jo(&quot;customer_company&quot;).Type = Newtonsoft.Json.Linq.JTokenType.Null&#xA;If Not (needDt OrElse needAgent OrElse needCo) Then Return&#xA;Dim dt As String = Nothing, agent As String = Nothing, co As String = Nothing&#xA;Try&#xA;    If serverId &gt; 0 AndAlso Not String.IsNullOrWhiteSpace(baseUrl) Then&#xA;        Using http As New System.Net.Http.HttpClient()&#xA;            http.Timeout = TimeSpan.FromSeconds(10)&#xA;            Dim body As String = http.GetStringAsync(baseUrl.TrimEnd(&quot;/&quot;c) &amp; &quot;/api/calls/&quot; &amp; serverId.ToString()).Result&#xA;            Dim rd As New Newtonsoft.Json.JsonTextReader(New System.IO.StringReader(body))&#xA;            rd.DateParseHandling = Newtonsoft.Json.DateParseHandling.None&#xA;            Dim d As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Load(rd)&#xA;            If d(&quot;call_datetime&quot;) IsNot Nothing AndAlso d(&quot;call_datetime&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then dt = CStr(d(&quot;call_datetime&quot;))&#xA;            If d(&quot;agent_name&quot;) IsNot Nothing AndAlso d(&quot;agent_name&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then agent = CStr(d(&quot;agent_name&quot;))&#xA;            If d(&quot;client_company&quot;) IsNot Nothing AndAlso d(&quot;client_company&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then co = CStr(d(&quot;client_company&quot;))&#xA;        End Using&#xA;    End If&#xA;Catch ex As Exception&#xA;    Console.WriteLine(&quot;[Performer] 서버 메타데이터 조회 실패(파일명으로 대체): &quot; &amp; ex.Message)&#xA;End Try&#xA;Dim m As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(System.IO.Path.GetFileNameWithoutExtension(audioPath), &quot;^(\d{8})_(\d{6})_([^_]+)_([^_]+)$&quot;)&#xA;If m.Success Then&#xA;    If dt Is Nothing Then dt = DateTime.ParseExact(m.Groups(1).Value &amp; m.Groups(2).Value, &quot;yyyyMMddHHmmss&quot;, System.Globalization.CultureInfo.InvariantCulture).ToString(&quot;yyyy-MM-ddTHH:mm:ss&quot;) &amp; &quot;+09:00&quot;&#xA;    If agent Is Nothing Then agent = m.Groups(3).Value&#xA;    If co Is Nothing Then co = m.Groups(4).Value&#xA;End If&#xA;If needDt AndAlso dt IsNot Nothing Then jo(&quot;call_datetime&quot;) = dt&#xA;If needAgent AndAlso agent IsNot Nothing Then jo(&quot;agent_name&quot;) = agent&#xA;If needCo AndAlso co IsNot Nothing Then jo(&quot;customer_company&quot;) = co" sap2010:Annotation.AnnotationText="③ 결과에 비어 있는 통화일시·