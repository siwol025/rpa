atus))]" /></If.Then></If><If Condition="[status &lt;&gt; &quot;FAILED&quot; AndAlso String.IsNullOrWhiteSpace(CType(jo.SelectToken(&quot;type_label&quot;), String))]" DisplayName="유형 필수값 검사"><If.Then><Throw DisplayName="업무 오류: 유형 누락" Exception="[(New BusinessRuleException(&quot;필수값 누락: type_label (유형)&quot;))]" /></If.Then></If><If Condition="[status &lt;&gt; &quot;FAILED&quot; AndAlso String.IsNullOrWhiteSpace(CType(jo.SelectToken(&quot;summary&quot;), String))]" DisplayName="요약 필수값 검사"><If.Then><Throw DisplayName="업무 오류: 요약 누락" Exception="[(New BusinessRuleException(&quot;필수값 누락: summary (요약)&quot;))]" /></If.Then></If></Sequence><If Condition="[status = &quot;FAILED&quot;]" DisplayName="status가 FAILED인가?" sap2010:Annotation.AnnotationText="정상·확인필요는 본 시트로, 실패는 예외 시트로 보낸다."><If.Then><Sequence DisplayName="예외 시트 기입" sap2010:Annotation.AnnotationText="분석에 실패한 통화(status=FAILED)는 본 시트가 아니라 예외 시트에 기록한다."><Assign DisplayName="수신시각 변환"><Assign.To><OutArgument x:TypeArguments="x:Object">[recvValue]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[If(String.IsNullOrWhiteSpace(CType(jo.SelectToken(&quot;source.received_at&quot;), String)), Nothing, CObj(DateTimeOffset.Parse(jo.SelectToken(&quot;source.received_at&quot;).ToString).DateTime))]</InArgument></Assign.Value></Assign><ueab:ReadRangeX DisplayName="예외 시트 읽기" HasHeaders="True" Range="[Excel.Sheet(&quot;예외&quot;)]" SaveTo="[errDT]" /><Assign DisplayName="같은 통화ID 행 찾기"><Assign.To><OutArgument x:TypeArguments="x:Int32">[rowIdx]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[errDT.AsEnumerable().ToList().FindIndex(Function(r) r(&quot;통화ID&quot;).ToString = callId)]</InArgument></Assign.Value></Assign><Assign DisplayName="기입할 엑셀 행 번호 계산"><Assign.To><OutArgument x:TypeArguments="x:Int32">[targetRow]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[If(rowIdx &gt;= 0, rowIdx + 2, If(errDT.Rows.Count = 0, 2, If(errDT.Rows.Count = 1 AndAl