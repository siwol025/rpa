# 운영 compose 용 환경 변수. 복사해서 deploy/.env 로 사용한다 (Git 에 커밋하지 않는다).

POSTGRES_PASSWORD=change-me

# 로봇 API: 키는 쉼표로 최대 2개(교체 기간용), IP/CIDR 은 로봇 PC 의 사내망 주소
# Docker 컨테이너에는 호스트 게이트웨이 주소로 보일 수 있으니 실제 접속 로그의 client_ip 로 확인한다
ROBOT_API_KEYS=change-me
ROBOT_ALLOWED_IPS=10.0.0.0/24

# 웹 화면 출처 (쉼표 구분)
CORS_ORIGINS=

# 웹 업로드 대상 (drive | local | disabled)
INBOX_BACKEND=disabled

STALE_THRESHOLD_MIN=30
MAX_UPLOAD_MB=100
LOG_LEVEL=INFO
# /docs 노출 여부. RPA 팀이 API 문서를 봐야 하면 true
DOCS_ENABLED=false
API_PORT=8000
