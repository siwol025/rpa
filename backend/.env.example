# 복사해서 .env 로 사용하세요. (.env 는 Git 에 커밋하지 않습니다)
# 항목 설명: docs/architecture/architecture.md §10.3

# --- DB ---
DATABASE_URL=postgresql+psycopg://callcenter:callcenter@localhost:5433/callcenter

# --- 음성 사본 저장소 ---
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_ROOT=./data/audio
# GCS_BUCKET=

# --- 웹 업로드 대상 (drive | local | disabled) ---
INBOX_BACKEND=local
INBOX_LOCAL_PATH=./data/inbox
# DRIVE_INBOX_FOLDER_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/drive-sa.json

# --- 로봇 API ---
ROBOT_API_KEYS=dev-robot-key
ROBOT_ALLOWED_IPS=127.0.0.1

# --- 업로드 / 처리 기준 ---
# 요청 전체 크기 한도(MiB, 1024²바이트). 모든 API 공통, 초과 시 413 PAYLOAD_TOO_LARGE
MAX_UPLOAD_MB=100
ALLOWED_EXTENSIONS=wav,mp3
REVIEW_CONFIDENCE_THRESHOLD=0.7
STALE_THRESHOLD_MIN=30

# --- 웹 ---
# 쉼표 구분 (예: http://localhost:5173,http://10.0.0.5:5173)
CORS_ORIGINS=http://localhost:5173

# --- 로그 ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- API 문서 ---
# /docs·/redoc·/openapi.json 노출 여부. 운영에서는 false
DOCS_ENABLED=true
