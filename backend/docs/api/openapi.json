      "RobotCallForm": {
        "description": "`POST /api/robot/calls`의 multipart 폼 필드 (파일은 `file`로 따로 받는다).\n\n담당자·통화 일시·고객사는 파일명에서 못 뽑았으면 비워 보낸다. 담당자나 통화 일시가\n비면 서버가 `metadata_incomplete=true`로 등록하고 웹에서 보정한다.",
        "properties": {
          "agent_name": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Name"
          },
          "call_datetime": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Call Datetime"
          },
          "client_company": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Company"
          },
          "file_hash": {
            "description": "파일 내용의 SHA-256(16진수 64자). 서버가 다시 계산해 비교한다.",
            "title": "File Hash",
            "type": "string"
          },
          "original_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Original Name",
            "type": "string"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Drive 파일 ID 등 출처 식별자",
            "title": "Source Ref"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          }
        },
        "required": [
          "file_hash",
          "original_name",
          "source_type"
        ],
        "title": "RobotCallForm",
        "type": "object"
      },
